+int avcodec_ohcodec_set_playback_speed(AVCodecContext *avctx, double speed)
+{
+    if (!avctx || !avctx->codec || !avctx->priv_data ||
+        !avctx->codec->wrapper_name ||
+        strcmp(avctx->codec->wrapper_name, "ohcodec"))
+        return AVERROR(ENOSYS);
+    if (!isfinite(speed) || speed <= 0.0)
+        return AVERROR(EINVAL);
+
+    OHCodecDecContext *s = avctx->priv_data;
+    if (fabs(s->requested_playback_speed - speed) <= 1e-6)
+        return 0;
+
+    s->requested_playback_speed = speed;
+    s->playback_policy_pending = true;
+    return 0;
+}
