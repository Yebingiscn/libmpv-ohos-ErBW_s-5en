+static void oh_decode_update_playback_policy(AVCodecContext *avctx)
+{
+    OHCodecDecContext *s = avctx->priv_data;
+    const double speed = s->requested_playback_speed;
+
+    if (!s->playback_policy_pending || !s->dec)
+        return;
+    s->playback_policy_pending = false;
+
+    const double effective_frame_rate = s->source_frame_rate *
+                                        (speed > 1.0 ? speed : 1.0);
+    const bool enable_smart_fluency = speed > 1.0 + 1e-6;
+    const bool update_smart_fluency = !s->smart_fluency_failed &&
+        s->keys.retention_mode && s->keys.decoder_speed &&
+        oh_decode_supports_smart_fluency(avctx) &&
+        (enable_smart_fluency || s->smart_fluency_active);
+
+    if (!update_smart_fluency && effective_frame_rate > 0.0 &&
+        s->keys.frame_rate) {
+        OH_AVFormat *rate_format = OH_AVFormat_Create();
+        if (rate_format) {
+            if (OH_AVFormat_SetDoubleValue(rate_format, s->keys.frame_rate,
+                                           effective_frame_rate)) {
+                OH_AVErrCode err = OH_VideoDecoder_SetParameter(s->dec,
+                                                                 rate_format);
+                if (err != AV_ERR_OK)
+                    av_log(avctx, AV_LOG_VERBOSE,
+                           "Failed to update OHCodec effective frame rate "
+                           "to %.3f: %d\n", effective_frame_rate, err);
+            }
+            OH_AVFormat_Destroy(rate_format);
+        }
+    }
+
+    if (!update_smart_fluency)
+        return;
+
+    OH_AVFormat *format = OH_AVFormat_Create();
+    if (!format)
+        return;
+
+    /* OH_FrameRetentionMode values are part of the API 26 ABI. Keep the
+     * constants local so older NDKs do not introduce symbol references. */
+    const int32_t retention_mode = enable_smart_fluency
+        ? 1 /* ADAPTIVE */ : 0 /* FULL */;
+    bool valid = true;
+    if (effective_frame_rate > 0.0 && s->keys.frame_rate)
+        valid = OH_AVFormat_SetDoubleValue(format, s->keys.frame_rate,
+                                           effective_frame_rate);
+    valid = valid && OH_AVFormat_SetIntValue(format, s->keys.retention_mode,
+                                             retention_mode);
+    if (enable_smart_fluency)
+        valid = valid && OH_AVFormat_SetDoubleValue(format,
+                                                    s->keys.decoder_speed,
+                                                    speed);
+
+    OH_AVErrCode err = valid ? OH_VideoDecoder_SetParameter(s->dec, format)
+                             : AV_ERR_INVALID_VAL;
+    OH_AVFormat_Destroy(format);
+
+    if (err != AV_ERR_OK) {
+        s->smart_fluency_failed = true;
+        av_log(avctx, AV_LOG_WARNING,
+               "OHCodec smart fluency decoding is unsupported: %d\n", err);
+        return;
+    }
+
+    s->smart_fluency_active = enable_smart_fluency;
+    av_log(avctx, AV_LOG_INFO,
+           "OHCodec smart fluency mode=%s speed=%.3f\n",
+           enable_smart_fluency ? "adaptive" : "full", speed);
+}
