+static const char *oh_decode_resolve_key(const char *symbol)
+{
+    const char *const *key = dlsym(RTLD_DEFAULT, symbol);
+    return key && *key && **key ? *key : NULL;
+}
+
+static void oh_decode_resolve_runtime_keys(OHCodecDecContext *s,
+                                           AVCodecContext *avctx)
+{
+    s->keys.frame_rate = oh_decode_resolve_key("OH_MD_KEY_FRAME_RATE");
+    s->keys.enable_vrr = oh_decode_resolve_key(
+        "OH_MD_KEY_VIDEO_DECODER_OUTPUT_ENABLE_VRR");
+    s->keys.retention_mode = oh_decode_resolve_key(
+        "OH_MD_KEY_VIDEO_DECODER_FRAME_RETENTION_MODE");
+    s->keys.decoder_speed = oh_decode_resolve_key(
+        "OH_MD_KEY_VIDEO_DECODER_SPEED");
+
+    if (!s->keys.frame_rate)
+        av_log(avctx, AV_LOG_WARNING,
+               "OHCodec frame-rate key is unavailable; VRR is disabled\n");
+    if (!s->keys.retention_mode || !s->keys.decoder_speed)
+        av_log(avctx, AV_LOG_VERBOSE,
+               "OHCodec smart fluency decoding is unavailable at runtime\n");
+}
+
+static bool oh_decode_supports_smart_fluency(const AVCodecContext *avctx)
+{
+    return avctx->codec_id == AV_CODEC_ID_H264 ||
+           avctx->codec_id == AV_CODEC_ID_HEVC ||
+           avctx->codec_id == AV_CODEC_ID_VVC;
+}
