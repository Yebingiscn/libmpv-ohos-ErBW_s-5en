+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#ifndef AVUTIL_AUDIO_VIVID_H
+#define AVUTIL_AUDIO_VIVID_H
+#include <stdint.h>
+/* Private OHOS pipeline contract. PCM must retain its original frame size,
+ * sample rate, channel order and S16 format. Metadata is owned by AVFrame. */
+typedef struct AVAudioVividMetadata {
+    uint64_t channel_layout;
+    uint32_t nb_samples;
+    uint32_t metadata_size;
+    uint8_t metadata[];
+} AVAudioVividMetadata;
+#endif
