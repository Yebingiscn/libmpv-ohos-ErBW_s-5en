                 OH_AVErrCode err = OH_VideoDecoder_SetParameter(s->dec,
                                                                  rate_format);
+                if (s->diagnostics_enabled)
+                    av_log(avctx, AV_LOG_VERBOSE,
+                           "[Perf] codec-decode-hints preroll=%d preserve=%d "
