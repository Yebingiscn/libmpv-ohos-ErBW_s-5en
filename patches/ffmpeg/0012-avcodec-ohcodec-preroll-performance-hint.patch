+int avcodec_ohcodec_set_decode_hints(AVCodecContext *avctx, int preroll,
+                                    int preserve_frames)
+{
+    if (!avctx || !avctx->codec || !avctx->priv_data ||
+        !avctx->codec->wrapper_name ||
+        strcmp(avctx->codec->wrapper_name, "ohcodec"))
+        return AVERROR(ENOSYS);
+    OHCodecDecContext *s = avctx->priv_data;
+    if (s->preroll == !!preroll && s->preserve_frames == !!preserve_frames)
+        return 0;
+    s->preroll = !!preroll;
+    s->preserve_frames = !!preserve_frames;
+    s->policy_requested_ns = s->diagnostics_enabled ? oh_decode_perf_time_ns() : 0;
+    s->playback_policy_pending = true;
+    return 0;
+}
