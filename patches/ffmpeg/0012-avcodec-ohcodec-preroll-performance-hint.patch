+/** Decoder-thread hint: accelerate preroll without changing media time.
+ * preserve_frames suppresses adaptive frame retention for timestamp repair.
+ * Other codecs return AVERROR(ENOSYS). Both flags accept zero or one.
+ */
+int avcodec_ohcodec_set_decode_hints(AVCodecContext *avctx, int preroll,
