+#ifndef AVFORMAT_OHOS_RCP_QUIC_H
+#define AVFORMAT_OHOS_RCP_QUIC_H
+#include <stdint.h>
+#include <stddef.h>
+#include <stdbool.h>
+typedef void Rcp_QuicConn;
+typedef void Rcp_QuicSession;
+typedef int Rcp_QuicErrorCode;
+typedef int Rcp_QuicConnOpt;
+typedef int Rcp_QuicStreamOpt;
+typedef int Rcp_QuicStreamDirection;
+enum {
+    RCP_QUIC_CONN_ON_CONNECTED_FUNCTION = 3,
+    RCP_QUIC_CONN_ON_ERROR_FUNCTION = 4,
+    RCP_QUIC_CONN_ON_CLOSED_FUNCTION = 5,
+    RCP_QUIC_CONN_STREAM_INBOUND_FUNCTION = 6,
+    RCP_QUIC_CONN_CONNECT_TIMEOUT_MS = 7,
+    RCP_QUIC_CONN_IDLE_TIMEOUT_MS = 8,
+    RCP_QUIC_TLS_CERT_AUTHORITY_FUNCTION = 1000,
+    RCP_QUIC_STREAM_EVENT_FUNCTION = 0,
+    RCP_QUIC_STREAM_DATA_FUNCTION = 1,
+    RCP_QUIC_INBOUND_STREAM_USER_OBJECT = 2,
+    RCP_QUIC_STREAM_BIDI = 0,
+    RCP_QUIC_STREAM_UNI = 1,
+    RCP_QUIC_ERROR_CODE_EAGAIN = 1007920015,
+};
+typedef struct Rcp_QuicIoVec { uint8_t *data; uint64_t length; } Rcp_QuicIoVec;
+typedef struct Rcp_QuicStreamData {
+    Rcp_QuicIoVec *iov;
+    uint32_t iovLen;
+    bool fin;
+} Rcp_QuicStreamData;
+typedef struct OhosQuicAPI {
+    Rcp_QuicSession *(*CreateSession)(void);
+    void (*DestroySession)(Rcp_QuicSession *);
+    Rcp_QuicConn *(*ConnCreate)(char *, void *);
+    int (*ConnSetOpt)(Rcp_QuicConn *, Rcp_QuicConnOpt, const void *, uint32_t);
+    int (*ConnConnect)(Rcp_QuicSession *, Rcp_QuicConn *, const char *, uint16_t);
+    int (*ConnDestroy)(Rcp_QuicConn *);
+    int (*StreamOpen)(Rcp_QuicConn *, Rcp_QuicStreamDirection, uint64_t *, void *);
+    int (*StreamSetOpt)(Rcp_QuicConn *, uint64_t, Rcp_QuicStreamOpt, const void *, uint32_t);
+    int (*StreamSend)(Rcp_QuicConn *, uint64_t, const Rcp_QuicIoVec *, uint32_t, bool);
+    int (*StreamWantRead)(Rcp_QuicConn *, uint64_t);
+    int (*StreamShutdown)(Rcp_QuicConn *, uint64_t, int, uint64_t);
+} OhosQuicAPI;
