diff --git a/libavcodec/ohcodec.h b/libavcodec/ohcodec.h
index 0747472..2ef900e 100644
--- a/libavcodec/ohcodec.h
+++ b/libavcodec/ohcodec.h
@@ -27,6 +27,7 @@
 #include <multimedia/player_framework/native_avformat.h>
 
 #include "libavutil/pixfmt.h"
+#include "libavutil/macros.h"
 
 #include "codec_id.h"
 
@@ -37,13 +38,49 @@ typedef struct OHBufferQueueItem {
 
 int ff_oh_err_to_ff_err(OH_AVErrCode err);
 
-static inline const char *ff_oh_mime(enum AVCodecID codec_id, void *log)
+static inline const char *ff_oh_mime(enum AVCodecID codec_id,
+                                     unsigned int codec_tag, void *log)
 {
     switch (codec_id) {
     case AV_CODEC_ID_H264:
         return OH_AVCODEC_MIMETYPE_VIDEO_AVC;
     case AV_CODEC_ID_HEVC:
         return OH_AVCODEC_MIMETYPE_VIDEO_HEVC;
+    case AV_CODEC_ID_MPEG1VIDEO:
+        return "video/mpeg";
+    case AV_CODEC_ID_MPEG2VIDEO:
+        return "video/mpeg2";
+    case AV_CODEC_ID_MPEG4:
+        return "video/mp4v-es";
+    case AV_CODEC_ID_H263:
+        return "video/h263";
+    case AV_CODEC_ID_VVC:
+        return "video/vvc";
+    case AV_CODEC_ID_AV1:
+        return "video/av1";
+    case AV_CODEC_ID_VP8:
+        return "video/vp8";
+    case AV_CODEC_ID_VP9:
+        return "video/vp9";
+    case AV_CODEC_ID_RV30:
+        return "video/rv30";
+    case AV_CODEC_ID_RV40:
+        return "video/rv40";
+    case AV_CODEC_ID_VC1:
+        return codec_tag == MKTAG('W', 'V', 'C', '1') ? "video/wvc1" :
+                                                        "video/vc1";
+    case AV_CODEC_ID_WMV3:
+        return "video/wmv3";
+    case AV_CODEC_ID_DVVIDEO:
+        return "video/dvvideo";
+    case AV_CODEC_ID_RAWVIDEO:
+        return "video/rawvideo";
+    case AV_CODEC_ID_MSVIDEO1:
+        return "video/msvideo1";
+    case AV_CODEC_ID_MJPEG:
+        return "video/mjpeg";
+    case AV_CODEC_ID_CINEPAK:
+        return "video/cinepak";
     default:
         av_log(log, AV_LOG_ERROR, "Unsupported codec %s\n",
                avcodec_get_name(codec_id));
diff --git a/libavcodec/ohdec.c b/libavcodec/ohdec.c
index 30d693a..0179125 100644
--- a/libavcodec/ohdec.c
+++ b/libavcodec/ohdec.c
@@ -259,7 +259,7 @@ static int oh_decode_create(OHCodecDecContext *s, AVCodecContext *avctx)
     const char *name = s->name;
 
     if (!name) {
-        const char *mime = ff_oh_mime(avctx->codec_id, avctx);
+        const char *mime = ff_oh_mime(avctx->codec_id, avctx->codec_tag, avctx);
         if (!mime)
             return AVERROR_BUG;
         OH_AVCapability *cap = OH_AVCodec_GetCapabilityByCategory(mime, false, HARDWARE);
@@ -1099,3 +1099,71 @@ DECLARE_OHCODEC_VDEC(h264, "H.264", AV_CODEC_ID_H264, "h264_mp4toannexb")
 #if CONFIG_HEVC_OH_DECODER
 DECLARE_OHCODEC_VDEC(hevc, "H.265", AV_CODEC_ID_HEVC, "hevc_mp4toannexb")
 #endif
+
+#if CONFIG_H263_OH_DECODER
+DECLARE_OHCODEC_VDEC(h263, "H.263", AV_CODEC_ID_H263, NULL)
+#endif
+
+#if CONFIG_MPEG1VIDEO_OH_DECODER
+DECLARE_OHCODEC_VDEC(mpeg1video, "MPEG-1 video", AV_CODEC_ID_MPEG1VIDEO, NULL)
+#endif
+
+#if CONFIG_MPEG2VIDEO_OH_DECODER
+DECLARE_OHCODEC_VDEC(mpeg2video, "MPEG-2 video", AV_CODEC_ID_MPEG2VIDEO, NULL)
+#endif
+
+#if CONFIG_MPEG4_OH_DECODER
+DECLARE_OHCODEC_VDEC(mpeg4, "MPEG-4 Part 2", AV_CODEC_ID_MPEG4, NULL)
+#endif
+
+#if CONFIG_VVC_OH_DECODER
+DECLARE_OHCODEC_VDEC(vvc, "H.266/VVC", AV_CODEC_ID_VVC, "vvc_mp4toannexb")
+#endif
+
+#if CONFIG_AV1_OH_DECODER
+DECLARE_OHCODEC_VDEC(av1, "AV1", AV_CODEC_ID_AV1, NULL)
+#endif
+
+#if CONFIG_VP8_OH_DECODER
+DECLARE_OHCODEC_VDEC(vp8, "VP8", AV_CODEC_ID_VP8, NULL)
+#endif
+
+#if CONFIG_VP9_OH_DECODER
+DECLARE_OHCODEC_VDEC(vp9, "VP9", AV_CODEC_ID_VP9, NULL)
+#endif
+
+#if CONFIG_RV30_OH_DECODER
+DECLARE_OHCODEC_VDEC(rv30, "RealVideo 3.0", AV_CODEC_ID_RV30, NULL)
+#endif
+
+#if CONFIG_RV40_OH_DECODER
+DECLARE_OHCODEC_VDEC(rv40, "RealVideo 4.0", AV_CODEC_ID_RV40, NULL)
+#endif
+
+#if CONFIG_VC1_OH_DECODER
+DECLARE_OHCODEC_VDEC(vc1, "SMPTE VC-1", AV_CODEC_ID_VC1, NULL)
+#endif
+
+#if CONFIG_WMV3_OH_DECODER
+DECLARE_OHCODEC_VDEC(wmv3, "Windows Media Video 9", AV_CODEC_ID_WMV3, NULL)
+#endif
+
+#if CONFIG_DVVIDEO_OH_DECODER
+DECLARE_OHCODEC_VDEC(dvvideo, "DV video", AV_CODEC_ID_DVVIDEO, NULL)
+#endif
+
+#if CONFIG_RAWVIDEO_OH_DECODER
+DECLARE_OHCODEC_VDEC(rawvideo, "raw video", AV_CODEC_ID_RAWVIDEO, NULL)
+#endif
+
+#if CONFIG_MSVIDEO1_OH_DECODER
+DECLARE_OHCODEC_VDEC(msvideo1, "Microsoft Video 1", AV_CODEC_ID_MSVIDEO1, NULL)
+#endif
+
+#if CONFIG_MJPEG_OH_DECODER
+DECLARE_OHCODEC_VDEC(mjpeg, "Motion JPEG", AV_CODEC_ID_MJPEG, NULL)
+#endif
+
+#if CONFIG_CINEPAK_OH_DECODER
+DECLARE_OHCODEC_VDEC(cinepak, "Cinepak", AV_CODEC_ID_CINEPAK, NULL)
+#endif
