diff --git a/audio/out/ohaudio_playhead.h b/audio/out/ohaudio_playhead.h
new file mode 100644
--- /dev/null
+++ b/audio/out/ohaudio_playhead.h
@@ -0,0 +1,15 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+#include <stdint.h>
+
+// Call with an already validated hardware sample and nonnegative sample age.
+// Zero positions can be stale across start/flush; extrapolate only once the
+// renderer has actually reported consuming PCM. No locks or clock API calls.
+static inline int64_t ohaudio_playhead(int64_t position, int64_t elapsed_ns,
+                                      int rate, int64_t written)
+{
+    if (position <= 0)
+        return 0;
+    int64_t played = position + elapsed_ns * rate / INT64_C(1000000000);
+    return played > written ? written : played;
+}
