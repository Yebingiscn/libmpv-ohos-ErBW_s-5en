diff --git a/video/out/ohos_vivid.h b/video/out/ohos_vivid.h
new file mode 100644
--- /dev/null
+++ b/video/out/ohos_vivid.h
@@ -0,0 +1,50 @@
+/* HDR Vivid raw SEI transport prototype. SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#define OHOS_VIVID_MAX_METADATA 3000
+struct ohos_vivid_frame {
+    uint8_t dynamic[OHOS_VIVID_MAX_METADATA];
+    uint8_t stat[OHOS_VIVID_MAX_METADATA];
+    size_t dynamic_size, static_size;
+    uintptr_t token;
+    uint64_t epoch;
+    double pts;
+    bool valid;
+};
+
+static inline bool ohos_vivid_matches(const struct ohos_vivid_frame *f,
+                                      uintptr_t token, uint64_t epoch)
+{
+    return f && f->valid && f->dynamic_size > 0 &&
+           f->dynamic_size <= OHOS_VIVID_MAX_METADATA &&
+           f->static_size <= OHOS_VIVID_MAX_METADATA &&
+           f->token == token && token && f->epoch == epoch;
+}
+
+static inline uint32_t ohos_vivid_hash(const uint8_t *data, size_t size)
+{
+    uint32_t hash = UINT32_C(2166136261);
+    for (size_t i = 0; i < size; i++)
+        hash = (hash ^ data[i]) * UINT32_C(16777619);
+    return hash;
+}
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+struct OH_NativeBuffer;
+struct ohos_vivid_read_info {
+    // 0=valid, 1=no buffer, 2=type read, 3=type layout, 4=not Vivid,
+    // 5=dynamic read/layout, 6=static layout. Native return/size aid device probes.
+    int stage, native_ret, size;
+};
+// Copies native new[] allocations into caller-owned bounded storage.
+bool ohos_vivid_read(struct OH_NativeBuffer *buffer, struct ohos_vivid_frame *out);
+bool ohos_vivid_read_ex(struct OH_NativeBuffer *buffer, struct ohos_vivid_frame *out,
+                        struct ohos_vivid_read_info *info);
+#ifdef __cplusplus
+}
+#endif
diff --git a/video/out/ohos_vivid.cpp b/video/out/ohos_vivid.cpp
new file mode 100644
--- /dev/null
+++ b/video/out/ohos_vivid.cpp
@@ -0,0 +1,89 @@
+/* HDR Vivid raw SEI transport prototype. SPDX-License-Identifier: LGPL-2.1-or-later */
+#include "ohos_vivid.h"
+
+#include <cstring>
+#include <native_buffer/native_buffer.h>
+
+namespace {
+// The platform getter allocates with new[] (including the metadata type).
+// Keep ownership independent of its return code for partial-failure cleanup.
+struct Metadata {
+    int32_t size = 0;
+    uint8_t *data = nullptr;
+    ~Metadata() { delete[] data; }
+    Metadata() = default;
+    Metadata(const Metadata &) = delete;
+    Metadata &operator=(const Metadata &) = delete;
+};
+}
+
+extern "C" bool ohos_vivid_read(OH_NativeBuffer *buffer, ohos_vivid_frame *out)
+{
+    return ohos_vivid_read_ex(buffer, out, nullptr);
+}
+
+extern "C" bool ohos_vivid_read_ex(OH_NativeBuffer *buffer, ohos_vivid_frame *out,
+                                   ohos_vivid_read_info *info)
+{
+    ohos_vivid_read_info ignored = {};
+    if (!info) info = &ignored;
+    *info = {};
+    if (!out)
+        return false;
+    *out = {};
+    if (!buffer) {
+        info->stage = 1;
+        return false;
+    }
+
+    Metadata type;
+    int type_ret = OH_NativeBuffer_GetMetadataValue(buffer, OH_HDR_METADATA_TYPE,
+                                                   &type.size, &type.data);
+    if (type_ret || !type.data || type.size != sizeof(OH_NativeBuffer_MetadataType)) {
+        *info = {type_ret ? 2 : 3, type_ret, type.size};
+        return false;
+    }
+    // Do not materialize an untrusted enum value or assume alignment of data.
+    int32_t value = 0;
+    static_assert(sizeof(value) == sizeof(OH_NativeBuffer_MetadataType));
+    std::memcpy(&value, type.data, sizeof(value));
+    if (value != static_cast<int32_t>(OH_VIDEO_HDR_VIVID)) {
+        *info = {4, 0, type.size};
+        return false;
+    }
+
+    Metadata dynamic;
+    int dynamic_ret = OH_NativeBuffer_GetMetadataValue(buffer, OH_HDR_DYNAMIC_METADATA,
+                                                      &dynamic.size, &dynamic.data);
+    if (dynamic_ret ||
+        !dynamic.data || dynamic.size <= 0 ||
+        dynamic.size > OHOS_VIVID_MAX_METADATA) {
+        *info = {5, dynamic_ret, dynamic.size};
+        return false;
+    }
+
+    ohos_vivid_frame captured = {};
+    captured.dynamic_size = static_cast<size_t>(dynamic.size);
+    std::memcpy(captured.dynamic, dynamic.data, captured.dynamic_size);
+
+    Metadata stat;
+    int ret = OH_NativeBuffer_GetMetadataValue(buffer, OH_HDR_STATIC_METADATA,
+                                             &stat.size, &stat.data);
+    if (ret == 0) {
+        // Static metadata is optional, but a reported payload must match the
+        // documented native structure. Do not transmit partial/foreign layouts.
+        if (!stat.data || stat.size != sizeof(OH_NativeBuffer_StaticMetadata) ||
+            stat.size > OHOS_VIVID_MAX_METADATA) {
+            *info = {6, ret, stat.size};
+            return false;
+        }
+        captured.static_size = static_cast<size_t>(stat.size);
+        std::memcpy(captured.stat, stat.data, captured.static_size);
+    }
+
+    captured.valid = true;
+    *out = captured;
+    // buffer is borrowed from the acquired NativeWindowBuffer. This function
+    // must not release its native reference or retain pointers into it.
+    return true;
+}
