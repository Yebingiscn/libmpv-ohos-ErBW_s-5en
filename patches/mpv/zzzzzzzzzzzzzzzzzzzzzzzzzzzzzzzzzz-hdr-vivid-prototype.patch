+
+// Testable output state transition: never continue a generic GPU render while
+// the window might still be tagged with an earlier frame's Vivid metadata.
+static bool vivid_restore_basic(struct vo_ohos_state *ctx)
+{
+    const struct pl_color_space color = ctx->output_color;
+    OH_NativeBuffer_MetadataType type = !is_hdr(&color) ? OH_VIDEO_NONE :
+        color.transfer == PL_COLOR_TRC_HLG ? OH_VIDEO_HDR_HLG : OH_VIDEO_HDR_HDR10;
+    int ret = OH_NativeWindow_SetMetadataValue(ctx->native_window,
+        OH_HDR_METADATA_TYPE, sizeof(type), (uint8_t *)&type);
+    if (!ret)
+        ret = OH_NativeWindow_SetColorSpace(ctx->native_window, get_color_space(&color));
+    if (ret) {
+        if (!ctx->vivid_restore_failed)
+            MP_ERR(ctx, "[Vivid] cannot restore basic output (%d); withholding frame\n", ret);
+        ctx->vivid_restore_failed = true;
+        return false;
+    }
+    ctx->vivid_restore_failed = false;
+    ctx->metadata_type_valid = false;
+    ctx->static_metadata_valid = false;
+    set_output_color(ctx, color);
+    return true;
+}
+
+uint64_t vo_ohos_vivid_epoch(struct vo *vo)
+{
+    return vo->ohos ? vo->ohos->vivid_epoch : 0;
+}
+
+void vo_ohos_vivid_reset(struct vo *vo)
+{
+    struct vo_ohos_state *ctx = vo->ohos;
+    if (!ctx) return;
+    ctx->vivid_epoch++;
+    bool restore = ctx->vivid_ready || ctx->vivid_restore_failed;
+    ctx->vivid_ready = false;
+    ctx->vivid_audits = 0;
+    ctx->vivid_expected = 0;
+    // Native APIs cannot erase the retained dynamic blob. A basic HDR type
+    // gates it off; never submit zero bytes or fabricate an empty Vivid SEI.
+    if (restore)
+        vivid_restore_basic(ctx);
+}
+
+int vo_ohos_vivid_prepare(struct vo *vo, const struct ohos_vivid_frame *frame,
+                          uintptr_t token, bool eligible, struct pl_color_space source)
+{
+    struct vo_ohos_state *ctx = vo->ohos;
+    if (!ctx) return false;
+    bool previous = ctx->vivid_ready;
+    ctx->vivid_ready = false;
+    bool valid = eligible &&
+                 !ctx->vivid_failed && !ctx->vpe && is_hdr(&source) &&
+                 ohos_vivid_matches(frame, token, ctx->vivid_epoch) &&
+                 (source.transfer != PL_COLOR_TRC_PQ || frame->static_size);
+    if (!valid) {
+        if ((previous || ctx->vivid_restore_failed) && !vivid_restore_basic(ctx))
+            return -1;
+        return 0;
+    }
+    // Stage BEFORE acquiring output, not from the input mapper or at present.
+    // Whether a vendor WSI copies these properties to the acquired image must
+    // still be verified: the public API does not guarantee per-acquire binding.
+    int ret = OH_NativeWindow_SetMetadataValue(ctx->native_window,
+        OH_HDR_DYNAMIC_METADATA, frame->dynamic_size, (uint8_t *)frame->dynamic);
+    if (ret && !previous && !ctx->vivid_restore_failed) {
+        // An unsupported dynamic-metadata setter must not break ordinary HDR:
+        // no Vivid type or source color has been applied on this attempt.
+        ctx->vivid_failed = true;
+        MP_WARN(ctx, "[Vivid] dynamic metadata unavailable (%d); keeping negotiated output\n", ret);
+        return 0;
+    }
+    if (!ret && frame->static_size)
+        ret = OH_NativeWindow_SetMetadataValue(ctx->native_window,
+            OH_HDR_STATIC_METADATA, frame->static_size, (uint8_t *)frame->stat);
+    if (!ret)
+        ret = OH_NativeWindow_SetColorSpace(ctx->native_window, get_color_space(&source));
+    OH_NativeBuffer_MetadataType type = OH_VIDEO_HDR_VIVID;
+    if (!ret)
+        ret = OH_NativeWindow_SetMetadataValue(ctx->native_window,
+            OH_HDR_METADATA_TYPE, sizeof(type), (uint8_t *)&type);
+    if (ret) {
+        ctx->vivid_failed = true;
+        MP_WARN(ctx, "[Vivid] metadata staging failed (%d); basic HDR fallback\n", ret);
+        return vivid_restore_basic(ctx) ? 0 : -1;
+    }
+    ctx->vivid_ready = true;
+    ctx->vivid_restore_failed = false;
+    ctx->color_space = get_color_space(&source);
+    ctx->color_space_valid = true;
+    ctx->metadata_type = type;
+    ctx->metadata_type_valid = true;
+    ctx->static_metadata_valid = frame->static_size != 0;
+    ctx->vivid_expected = ohos_vivid_hash(frame->dynamic, frame->dynamic_size);
+    if (ctx->vivid_audits < 16)
+        MP_INFO(ctx, "[Vivid] staged-before-acquire epoch=%"PRIu64" pts=%.6f bytes=%zu hash=%08x\n",
+                frame->epoch, frame->pts, frame->dynamic_size, ctx->vivid_expected);
+    return true;
+}
+
+void vo_ohos_vivid_audit(struct vo *vo)
+{
+    struct vo_ohos_state *ctx = vo->ohos;
+    if (!ctx || !ctx->vivid_ready || ctx->vivid_audits++ >= 16) return;
+    OHNativeWindowBuffer *wb = NULL;
+    int fence = -1;
+    float matrix[16];
+    int ret = OH_NativeWindow_GetLastFlushedBufferV2(ctx->native_window, &wb, &fence, matrix);
+    if (fence >= 0) close(fence);
+    struct ohos_vivid_frame output = {0};
+    OH_NativeBuffer *buffer = NULL;
+    if (!ret && wb && !OH_NativeBuffer_FromNativeWindowBuffer(wb, &buffer))
+        ohos_vivid_read(buffer, &output);
+    // Last-flushed can lag present. This log is evidence for WSI validation,
+    // not a claim that the compositor consumed this frame's dynamic metadata.
+    MP_INFO(ctx, "[Vivid] last-flushed ret=%d valid=%d bytes=%zu hash=%08x current=%08x (async)\n",
+            ret, output.valid, output.dynamic_size,
+            ohos_vivid_hash(output.dynamic, output.dynamic_size), ctx->vivid_expected);
+    if (wb) OH_NativeWindow_NativeObjectUnreference(wb);
+}
