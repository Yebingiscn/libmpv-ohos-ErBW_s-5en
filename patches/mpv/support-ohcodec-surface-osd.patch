+#include "vo.h"
+
+/*
+ * OHCodec owns the opaque video plane. mpv/libass renders subtitles and OSD
+ * into a second, transparent NativeWindow supplied by the embedding app.
+ *
+ * The exported setter intentionally mirrors --wid's surface-id based API. It
+ * may be called before or after mpv_initialize(). The latter is important for
+ * ArkUI, where the two XComponents are not guaranteed to be created in order.
+ */
+struct global_osd_surface {
+    mp_static_mutex lock;
+    uint64_t id;
+    int width;
+    int height;
+    struct vo *active_vo;
+};
+
+static struct global_osd_surface global_osd = {
+    .lock = MP_STATIC_MUTEX_INITIALIZER,
+};
+
+MPV_EXPORT void ohos_osd_set_global_surface(uint64_t surface_id,
+                                            int width, int height)
+{
+    mp_mutex_lock(&global_osd.lock);
+    global_osd.id = surface_id;
+    global_osd.width = MPMAX(width, 0);
+    global_osd.height = MPMAX(height, 0);
+    if (global_osd.active_vo)
+        vo_redraw(global_osd.active_vo);
+    mp_mutex_unlock(&global_osd.lock);
+}
+
+struct priv {
+    struct mp_image *next_image;
+    struct mp_hwdec_ctx hwctx;
+
+    OHNativeWindow *osd_window;
+    uint64_t osd_surface_id;
+    int osd_surface_width;
+    int osd_surface_height;
+    int osd_width;
+    int osd_height;
+    bool osd_force_upload;
+    bool warned_missing_osd;
+
+    struct mp_draw_sub_cache *osd_cache;
+    struct mp_osd_res osd_res;
+    double last_pts;
+    int64_t next_render_time_ns;
+};
+
+static int64_t get_surface_time_ns(void)
+{
+    struct timespec ts;
+    if (clock_gettime(CLOCK_MONOTONIC, &ts) < 0)
+        return 0;
+    return MP_TIME_S_TO_NS(ts.tv_sec) + ts.tv_nsec;
+}
+
+static void free_ohcodec_device(AVHWDeviceContext *ctx)
+{
+    AVOHCodecDeviceContext *hwctx = ctx->hwctx;
+    if (hwctx->native_window) {
+        OH_NativeWindow_DestroyNativeWindow(hwctx->native_window);
+        hwctx->native_window = NULL;
+    }
+}
+
+static AVBufferRef *create_ohcodec_device_ref(struct vo *vo)
+{
+    if (vo->opts->WinID == 0 || vo->opts->WinID == -1) {
+        MP_ERR(vo, "Missing video Surface id (--wid)\n");
+        return NULL;
+    }
+
+    AVBufferRef *device_ref = av_hwdevice_ctx_alloc(AV_HWDEVICE_TYPE_OHCODEC);
+    if (!device_ref)
+        return NULL;
+
+    AVHWDeviceContext *ctx = (void *)device_ref->data;
+    AVOHCodecDeviceContext *hwctx = ctx->hwctx;
+    uint64_t surface = 0;
+    memcpy(&surface, &vo->opts->WinID, sizeof(vo->opts->WinID));
+
+    int ret = OH_NativeWindow_CreateNativeWindowFromSurfaceId(
+        surface, (OHNativeWindow **)&hwctx->native_window);
+    if (ret != 0 || !hwctx->native_window) {
+        MP_ERR(vo, "Failed to create video NativeWindow: %d\n", ret);
+        av_buffer_unref(&device_ref);
+        return NULL;
+    }
+    ctx->free = free_ohcodec_device;
+
+    OHNativeWindow *window = hwctx->native_window;
+    ret = OH_NativeWindow_NativeWindowSetScalingModeV2(
+        window, OH_SCALING_MODE_SCALE_FIT_V2);
+    if (ret != 0)
+        MP_WARN(vo, "Failed to set video Surface scale-fit mode: %d\n", ret);
+    ret = OH_NativeWindow_NativeWindowHandleOpt(
+        window, SET_SOURCE_TYPE, OH_SURFACE_SOURCE_VIDEO);
+    if (ret != 0)
+        MP_VERBOSE(vo, "Failed to mark video Surface source type: %d\n", ret);
+
+    if (av_hwdevice_ctx_init(device_ref) < 0)
+        av_buffer_unref(&device_ref);
+
+    return device_ref;
+}
+
+static void update_osd_resolution(struct vo *vo)
+{
+    struct priv *p = vo->priv;
+    if (!vo->params)
+        return;
+
+    int width = p->osd_width > 0 ? p->osd_width : vo->dwidth;
+    int height = p->osd_height > 0 ? p->osd_height : vo->dheight;
+    if (width <= 0 || height <= 0)
+        return;
+
+    int old_width = vo->dwidth;
+    int old_height = vo->dheight;
+    struct mp_rect src, dst;
+
+    /*
+     * vo_get_src_dst_rects() describes both the visible video rectangle and
+     * the subtitle margins. Calculate it in OSD Surface coordinates, which
+     * also handles an ArkUI density/size mismatch between the two surfaces.
+     */
+    vo->dwidth = width;
+    vo->dheight = height;
+    vo_get_src_dst_rects(vo, &src, &dst, &p->osd_res);
+    vo->dwidth = old_width;
+    vo->dheight = old_height;
+}
+
+static bool get_video_surface_size(struct vo *vo, int *out_w, int *out_h)
+{
+    struct priv *p = vo->priv;
+    AVHWDeviceContext *ctx = (void *)p->hwctx.av_device_ref->data;
+    AVOHCodecDeviceContext *hwctx = ctx->hwctx;
+    OHNativeWindow *window = hwctx->native_window;
+
+    int width = vo->opts->ohos_surface_size.w;
+    int height = vo->opts->ohos_surface_size.h;
+    if ((!width || !height) && window) {
+        int queried_width = 0;
+        int queried_height = 0;
+        int ret = OH_NativeWindow_NativeWindowHandleOpt(
+            window, GET_BUFFER_GEOMETRY, &queried_height, &queried_width);
+        if (ret == 0) {
+            width = queried_width;
+            height = queried_height;
+        }
+    }
+
+    if (width <= 0 || height <= 0)
+        return false;
+    *out_w = width;
+    *out_h = height;
+    return true;
+}
+
+static void update_video_scaling_mode(struct vo *vo)
+{
+    struct priv *p = vo->priv;
+    if (!p->hwctx.av_device_ref)
+        return;
+
+    AVHWDeviceContext *ctx = (void *)p->hwctx.av_device_ref->data;
+    AVOHCodecDeviceContext *hwctx = ctx->hwctx;
+    OHNativeWindow *window = hwctx->native_window;
+    if (!window)
+        return;
+
+    OHScalingModeV2 mode = vo->opts->keepaspect
+        ? OH_SCALING_MODE_SCALE_FIT_V2
+        : OH_SCALING_MODE_SCALE_TO_WINDOW_V2;
+    int ret = OH_NativeWindow_NativeWindowSetScalingModeV2(window, mode);
+    if (ret != 0) {
+        MP_WARN(vo, "Failed to update video Surface scaling mode: %d\n", ret);
+    } else {
+        MP_VERBOSE(vo, "Video Surface scaling mode: %s\n",
+                   vo->opts->keepaspect ? "fit" : "stretch");
+    }
+}
+
+static void resize(struct vo *vo)
+{
+    int width = 0;
+    int height = 0;
+    if (get_video_surface_size(vo, &width, &height)) {
+        vo->dwidth = width;
+        vo->dheight = height;
+    }
+    update_video_scaling_mode(vo);
+    update_osd_resolution(vo);
+    vo->want_redraw = true;
+}
+
+static void destroy_osd_window(struct priv *p)
+{
+    if (p->osd_window)
+        OH_NativeWindow_DestroyNativeWindow(p->osd_window);
+    p->osd_window = NULL;
+    p->osd_surface_id = 0;
+    p->osd_surface_width = 0;
+    p->osd_surface_height = 0;
+    p->osd_width = 0;
+    p->osd_height = 0;
+}
+
+static bool configure_osd_window(struct vo *vo, OHNativeWindow *window,
+                                 int width, int height)
+{
+    int ret = OH_NativeWindow_NativeWindowHandleOpt(
+        window, SET_BUFFER_GEOMETRY, width, height);
+    if (ret != 0) {
+        MP_ERR(vo, "Failed to set OSD Surface geometry: %d\n", ret);
+        return false;
+    }
+
+    ret = OH_NativeWindow_NativeWindowHandleOpt(
+        window, SET_FORMAT, NATIVEBUFFER_PIXEL_FMT_BGRA_8888);
+    if (ret != 0) {
+        MP_ERR(vo, "Failed to set OSD Surface BGRA format: %d\n", ret);
+        return false;
+    }
+
+    uint64_t usage = NATIVEBUFFER_USAGE_CPU_WRITE |
+                     NATIVEBUFFER_USAGE_CPU_READ;
+    ret = OH_NativeWindow_NativeWindowHandleOpt(window, SET_USAGE, usage);
+    if (ret != 0) {
+        MP_ERR(vo, "Failed to set OSD Surface CPU usage: %d\n", ret);
+        return false;
+    }
+
+    ret = OH_NativeWindow_NativeWindowHandleOpt(
+        window, SET_SOURCE_TYPE, OH_SURFACE_SOURCE_UI);
+    if (ret != 0)
+        MP_VERBOSE(vo, "Failed to mark OSD Surface source type: %d\n", ret);
+
+    return true;
+}
+
+static bool sync_osd_window(struct vo *vo)
+{
+    struct priv *p = vo->priv;
+    uint64_t id;
+    int width;
+    int height;
+
+    mp_mutex_lock(&global_osd.lock);
+    id = global_osd.id;
+    width = global_osd.width;
+    height = global_osd.height;
+    mp_mutex_unlock(&global_osd.lock);
+
+    if (id == p->osd_surface_id && width == p->osd_surface_width &&
+        height == p->osd_surface_height)
+        return p->osd_window != NULL;
+
+    destroy_osd_window(p);
+    p->osd_force_upload = true;
+
+    if (!id || width <= 0 || height <= 0) {
+        if (!p->warned_missing_osd) {
+            MP_WARN(vo, "OSD Surface is not ready; video will continue "
+                        "without subtitles until it is supplied\n");
+            p->warned_missing_osd = true;
+        }
+        return false;
+    }
+
+    OHNativeWindow *window = NULL;
+    int ret = OH_NativeWindow_CreateNativeWindowFromSurfaceId(id, &window);
+    if (ret != 0 || !window) {
+        MP_ERR(vo, "Failed to create OSD NativeWindow: %d\n", ret);
+        return false;
+    }
+    if (!configure_osd_window(vo, window, width, height)) {
+        OH_NativeWindow_DestroyNativeWindow(window);
+        return false;
+    }
+
+    p->osd_window = window;
+    p->osd_surface_id = id;
+    p->osd_surface_width = width;
+    p->osd_surface_height = height;
+    p->osd_width = width;
+    p->osd_height = height;
+    p->warned_missing_osd = false;
+    update_osd_resolution(vo);
+    MP_INFO(vo, "OSD Surface attached: %" PRIu64 " (%dx%d)\n",
+            id, width, height);
+    return true;
+}
+
+static bool wait_and_close_fence(struct vo *vo, int fence_fd)
+{
+    if (fence_fd < 0)
+        return true;
+
+    struct pollfd pfd = {
+        .fd = fence_fd,
+        .events = POLLIN,
+    };
+    int ret;
+    do {
+        ret = poll(&pfd, 1, 3000);
+    } while (ret < 0 && errno == EINTR);
+    close(fence_fd);
+
+    if (ret <= 0) {
+        MP_ERR(vo, "Timed out waiting for OSD buffer fence\n");
+        return false;
+    }
+    return true;
+}
+
+static bool upload_osd(struct vo *vo, struct mp_image *osd)
+{
+    struct priv *p = vo->priv;
+    OHNativeWindowBuffer *window_buffer = NULL;
+    OH_NativeBuffer *native_buffer = NULL;
+    int fence_fd = -1;
+    void *mapped = NULL;
+    bool buffer_requested = false;
+    bool buffer_mapped = false;
+    bool ok = false;
+
+    int ret = OH_NativeWindow_NativeWindowRequestBuffer(
+        p->osd_window, &window_buffer, &fence_fd);
+    if (ret != 0 || !window_buffer) {
+        MP_ERR(vo, "Failed to request OSD Surface buffer: %d\n", ret);
+        goto done;
+    }
+    buffer_requested = true;
+
+    if (!wait_and_close_fence(vo, fence_fd)) {
+        fence_fd = -1;
+        goto done;
+    }
+    fence_fd = -1;
+
+    ret = OH_NativeBuffer_FromNativeWindowBuffer(window_buffer,
+                                                  &native_buffer);
+    if (ret != 0 || !native_buffer) {
+        MP_ERR(vo, "Failed to access OSD NativeBuffer: %d\n", ret);
+        goto done;
+    }
+
+    ret = OH_NativeBuffer_Map(native_buffer, &mapped);
+    if (ret != 0 || !mapped) {
+        MP_ERR(vo, "Failed to map OSD NativeBuffer: %d\n", ret);
+        goto done;
+    }
+    buffer_mapped = true;
+
+    BufferHandle *handle =
+        OH_NativeWindow_GetBufferHandleFromNative(window_buffer);
+    if (!handle) {
+        MP_ERR(vo, "OSD buffer has no BufferHandle\n");
+        goto done;
+    }
+
+    int dst_stride = handle->stride;
+    int buffer_width = handle->width;
+    int buffer_height = handle->height;
+    if (buffer_width <= 0 || buffer_height <= 0 ||
+        dst_stride < buffer_width * 4 ||
+        (handle->size > 0 &&
+         (int64_t)dst_stride * buffer_height > handle->size))
+    {
+        MP_ERR(vo, "Invalid OSD buffer layout: width=%d height=%d "
+               "stride=%d size=%d\n", buffer_width, buffer_height,
+               dst_stride, handle->size);
+        goto done;
+    }
+
+    /*
+     * An ArkUI XComponent can keep the same Surface id and requested size
+     * while its producer buffers switch to a new physical size on rotation.
+     * The BufferHandle is the authoritative layout. Re-render at that size
+     * before copying, otherwise the old, larger overlay either overflows the
+     * buffer or remains frozen on screen.
+     */
+    if (buffer_width != p->osd_width || buffer_height != p->osd_height) {
+        MP_INFO(vo, "OSD buffer geometry changed: requested=%dx%d, "
+                "render=%dx%d -> %dx%d (stride=%d size=%d)\n",
+                p->osd_surface_width, p->osd_surface_height,
+                p->osd_width, p->osd_height, buffer_width, buffer_height,
+                dst_stride, handle->size);
+        p->osd_width = buffer_width;
+        p->osd_height = buffer_height;
+        p->osd_force_upload = true;
+        update_osd_resolution(vo);
+        vo->want_redraw = true;
+        goto done;
+    }
+
+    memcpy_pic(mapped, osd->planes[0], p->osd_width * 4, p->osd_height,
+               dst_stride, osd->stride[0]);
+    if (dst_stride > p->osd_width * 4) {
+        for (int y = 0; y < p->osd_height; y++) {
+            memset((uint8_t *)mapped + y * dst_stride + p->osd_width * 4,
+                   0, dst_stride - p->osd_width * 4);
+        }
+    }
+
+    ret = OH_NativeBuffer_Unmap(native_buffer);
+    buffer_mapped = false;
+    if (ret != 0) {
+        MP_ERR(vo, "Failed to unmap OSD NativeBuffer: %d\n", ret);
+        goto done;
+    }
+
+    struct Rect dirty_rect = {
+        .x = 0,
+        .y = 0,
+        .w = p->osd_width,
+        .h = p->osd_height,
+    };
+    Region region = {
+        .rects = &dirty_rect,
+        .rectNumber = 1,
+    };
+    ret = OH_NativeWindow_NativeWindowFlushBuffer(
+        p->osd_window, window_buffer, -1, region);
+    if (ret != 0) {
+        MP_ERR(vo, "Failed to flush OSD Surface buffer: %d\n", ret);
+        goto done;
+    }
+
+    buffer_requested = false;
+    ok = true;
+
+done:
+    if (buffer_mapped)
+        OH_NativeBuffer_Unmap(native_buffer);
+    if (fence_fd >= 0)
+        close(fence_fd);
+    if (buffer_requested)
+        OH_NativeWindow_NativeWindowAbortBuffer(p->osd_window, window_buffer);
+    return ok;
+}
+
+static bool draw_osd(struct vo *vo, double pts)
+{
+    struct priv *p = vo->priv;
+    if (!sync_osd_window(vo))
+        return false;
+
+    if (!p->osd_cache)
+        p->osd_cache = mp_draw_sub_alloc(p, vo->global);
+
+    struct sub_bitmap_list *sbs = osd_render(
+        vo->osd, p->osd_res, pts, 0, mp_draw_sub_formats);
+    if (!sbs)
+        return false;
+
+    struct mp_rect act_rect[1];
+    struct mp_rect mod_rect[64];
+    int num_act_rect = 0;
+    int num_mod_rect = 0;
+    struct mp_image *osd = mp_draw_sub_overlay(
+        p->osd_cache, sbs,
+        act_rect, MP_ARRAY_SIZE(act_rect), &num_act_rect,
+        mod_rect, MP_ARRAY_SIZE(mod_rect), &num_mod_rect);
+    talloc_free(sbs);
+
+    if (!osd)
+        return false;
+    if (!num_mod_rect && !p->osd_force_upload)
+        return true;
+    if (osd->w != p->osd_width || osd->h != p->osd_height) {
+        MP_ERR(vo, "OSD renderer size mismatch: %dx%d, Surface %dx%d\n",
+               osd->w, osd->h, p->osd_width, p->osd_height);
+        return false;
+    }
+
+    bool ok = upload_osd(vo, osd);
+    if (ok)
+        p->osd_force_upload = false;
+    return ok;
+}
+
+static int preinit(struct vo *vo)
+{
+    struct priv *p = vo->priv;
+
+    vo->hwdec_devs = hwdec_devices_create();
+    p->hwctx = (struct mp_hwdec_ctx){
+        .driver_name = "ohcodec",
+        .av_device_ref = create_ohcodec_device_ref(vo),
+        .hw_imgfmt = IMGFMT_OHCODEC,
+    };
+    if (!p->hwctx.av_device_ref) {
+        MP_ERR(vo, "Failed to create OHCodec Surface device\n");
+        hwdec_devices_destroy(vo->hwdec_devs);
+        vo->hwdec_devs = NULL;
+        return -1;
+    }
+
+    hwdec_devices_add(vo->hwdec_devs, &p->hwctx);
+    p->osd_force_upload = true;
+
+    mp_mutex_lock(&global_osd.lock);
+    if (global_osd.active_vo && global_osd.active_vo != vo)
+        MP_WARN(vo, "Replacing an existing OHCodec OSD output instance\n");
+    global_osd.active_vo = vo;
+    mp_mutex_unlock(&global_osd.lock);
+
+    sync_osd_window(vo);
+    return 0;
+}
+
+static int reconfig(struct vo *vo, struct mp_image_params *params)
+{
+    resize(vo);
+    return 0;
+}
+
+static int query_format(struct vo *vo, int format)
+{
+    return format == IMGFMT_OHCODEC;
+}
+
+static bool draw_frame(struct vo *vo, struct vo_frame *frame)
+{
+    struct priv *p = vo->priv;
+    struct mp_image *image = NULL;
+
+    if (frame->current)
+        p->last_pts = frame->current->pts;
+    if (!frame->redraw && !frame->repeat && frame->current) {
+        image = mp_image_new_ref(frame->current);
+        int64_t now = mp_time_ns();
+        int64_t delay = frame->pts > now ? frame->pts - now : 0;
+        p->next_render_time_ns = get_surface_time_ns() + delay;
+    }
+
+    mp_image_unrefp(&p->next_image);
+    p->next_image = image;
+
+    draw_osd(vo, p->last_pts);
+    return VO_TRUE;
+}
+
+static void flip_page(struct vo *vo)
+{
+    struct priv *p = vo->priv;
+    if (!p->next_image)
+        return;
+
+    AVOHCodecBuffer *buffer =
+        (AVOHCodecBuffer *)p->next_image->planes[3];
+    if (!buffer) {
+        MP_ERR(vo, "OHCodec frame is missing its output token\n");
+    } else {
+        int ret = p->next_render_time_ns > 0
+            ? av_ohcodec_release_buffer_at_time(buffer,
+                                                p->next_render_time_ns)
+            : av_ohcodec_release_buffer(buffer, 1);
+        if (ret < 0 && ret != AVERROR(EALREADY) && ret != AVERROR(ESTALE))
+            MP_ERR(vo, "Failed to present OHCodec Surface frame: %d\n", ret);
+    }
+    mp_image_unrefp(&p->next_image);
+}
+
+static int control(struct vo *vo, uint32_t request, void *data)
+{
+    struct priv *p = vo->priv;
+
+    switch (request) {
+    case VOCTRL_SET_PANSCAN:
+    case VOCTRL_VO_OPTS_CHANGED:
+        resize(vo);
+        return VO_TRUE;
+    case VOCTRL_REDRAW:
+        p->osd_force_upload = true;
+        return VO_TRUE;
+    case VOCTRL_RESET:
+        mp_image_unrefp(&p->next_image);
+        p->osd_force_upload = true;
+        return VO_TRUE;
+    }
+    return VO_NOTIMPL;
+}
+
+static void uninit(struct vo *vo)
+{
+    struct priv *p = vo->priv;
+
+    mp_mutex_lock(&global_osd.lock);
+    if (global_osd.active_vo == vo)
+        global_osd.active_vo = NULL;
+    mp_mutex_unlock(&global_osd.lock);
+
+    mp_image_unrefp(&p->next_image);
+    destroy_osd_window(p);
+
+    if (vo->hwdec_devs)
+        hwdec_devices_remove(vo->hwdec_devs, &p->hwctx);
+    av_buffer_unref(&p->hwctx.av_device_ref);
+    if (vo->hwdec_devs) {
+        hwdec_devices_destroy(vo->hwdec_devs);
+        vo->hwdec_devs = NULL;
+    }
+}
+
+const struct vo_driver video_out_ohcodec = {
+    .description = "HarmonyOS OHCodec Surface with transparent OSD",
+    .name = "ohcodec-osd",
+    .caps = VO_CAP_NORETAIN,
+    .preinit = preinit,
+    .query_format = query_format,
+    .control = control,
+    .draw_frame = draw_frame,
+    .flip_page = flip_page,
+    .reconfig = reconfig,
+    .uninit = uninit,
+    .priv_size = sizeof(struct priv),
+};
