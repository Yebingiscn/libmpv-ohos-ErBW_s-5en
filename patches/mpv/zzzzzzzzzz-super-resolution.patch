diff --git a/video/out/ohos_vpe.c b/video/out/ohos_vpe.c
new file mode 100644
--- /dev/null
+++ b/video/out/ohos_vpe.c
@@ -0,0 +1,155 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#include "ohos_vpe.h"
+
+#include <stdatomic.h>
+#include <stdlib.h>
+#include <multimedia/video_processing_engine/video_processing.h>
+#include <multimedia/player_framework/native_avformat.h>
+
+#include "common/msg.h"
+
+struct ohos_vpe {
+    OH_VideoProcessing *processor;
+    OHNativeWindow *input;
+    OHNativeWindow *output;
+    atomic_int error;
+    bool running;
+    bool fallback_queued;
+    int width;
+    int height;
+};
+
+static void on_error(OH_VideoProcessing *processor,
+                     VideoProcessing_ErrorCode error, void *data)
+{
+    struct ohos_vpe *vpe = data;
+    atomic_store(&vpe->error, error);
+}
+
+static void on_output(OH_VideoProcessing *processor, uint32_t index, void *data)
+{
+    struct ohos_vpe *vpe = data;
+    int ret = OH_VideoProcessing_RenderOutputBuffer(processor, index);
+    if (ret != VIDEO_PROCESSING_SUCCESS)
+        atomic_store(&vpe->error, ret);
+}
+
+void ohos_vpe_destroy(struct ohos_vpe *vpe)
+{
+    if (!vpe)
+        return;
+    // Never release callback user data until the vendor instance is destroyed.
+    if (vpe->running)
+        OH_VideoProcessing_Stop(vpe->processor);
+    if (vpe->processor && OH_VideoProcessing_Destroy(vpe->processor) !=
+                              VIDEO_PROCESSING_SUCCESS) {
+        // An unresponsive vendor instance may still call us. Retaining its
+        // small context and input window is safer than a callback use-after-free.
+        return;
+    }
+    if (vpe->input)
+        OH_NativeWindow_DestroyNativeWindow(vpe->input);
+    free(vpe);
+}
+
+void ohos_vpe_resize(struct ohos_vpe *vpe, int width, int height)
+{
+    if (!vpe || width <= 0 || height <= 0)
+        return;
+    if (vpe->width == width && vpe->height == height)
+        return;
+    int ret = OH_NativeWindow_NativeWindowHandleOpt(
+        vpe->output, SET_BUFFER_GEOMETRY, width, height);
+    if (ret)
+        atomic_store(&vpe->error, ret);
+    else {
+        vpe->width = width;
+        vpe->height = height;
+    }
+}
+
+struct ohos_vpe *ohos_vpe_create(struct mp_log *log, OHNativeWindow *output,
+                                int width, int height)
+{
+    struct ohos_vpe *vpe = calloc(1, sizeof(*vpe));
+    if (!vpe)
+        return NULL;
+    atomic_init(&vpe->error, 0);
+    vpe->output = output;
+    VideoProcessing_Callback *callbacks = NULL;
+    OH_AVFormat *format = NULL;
+    int ret = OH_VideoProcessing_Create(&vpe->processor,
+                                        VIDEO_PROCESSING_TYPE_DETAIL_ENHANCER);
+    if (ret)
+        goto fail;
+    ret = OH_VideoProcessingCallback_Create(&callbacks);
+    if (ret)
+        goto fail;
+    ret = OH_VideoProcessingCallback_BindOnError(callbacks, on_error);
+    if (ret)
+        goto fail;
+    ret = OH_VideoProcessingCallback_BindOnNewOutputBuffer(callbacks, on_output);
+    if (ret)
+        goto fail;
+    ret = OH_VideoProcessing_RegisterCallback(vpe->processor, callbacks, vpe);
+    if (ret)
+        goto fail;
+    OH_VideoProcessingCallback_Destroy(callbacks);
+    callbacks = NULL;
+    format = OH_AVFormat_Create();
+    if (!format) {
+        ret = VIDEO_PROCESSING_ERROR_NO_MEMORY;
+        goto fail;
+    }
+    if (!OH_AVFormat_SetIntValue(format,
+            VIDEO_DETAIL_ENHANCER_PARAMETER_KEY_QUALITY_LEVEL,
+            VIDEO_DETAIL_ENHANCER_QUALITY_LEVEL_HIGH)) {
+        ret = VIDEO_PROCESSING_ERROR_INVALID_PARAMETER;
+        goto fail;
+    }
+    ret = OH_VideoProcessing_SetParameter(vpe->processor, format);
+    if (ret)
+        goto fail;
+    OH_AVFormat_Destroy(format);
+    format = NULL;
+    ohos_vpe_resize(vpe, width, height);
+    ret = atomic_load(&vpe->error);
+    if (ret)
+        goto fail;
+    ret = OH_VideoProcessing_SetSurface(vpe->processor, output);
+    if (ret)
+        goto fail;
+    ret = OH_VideoProcessing_GetSurface(vpe->processor, &vpe->input);
+    if (ret)
+        goto fail;
+    ret = OH_VideoProcessing_Start(vpe->processor);
+    if (ret)
+        goto fail;
+    vpe->running = true;
+    mp_warn(log, "[SuperResolution] VPE high quality enabled\n");
+    return vpe;
+fail:
+    if (format)
+        OH_AVFormat_Destroy(format);
+    if (callbacks)
+        OH_VideoProcessingCallback_Destroy(callbacks);
+    mp_warn(log, "[SuperResolution] VPE unavailable (%d); using normal output\n", ret);
+    ohos_vpe_destroy(vpe);
+    return NULL;
+}
+
+OHNativeWindow *ohos_vpe_input(struct ohos_vpe *vpe)
+{
+    return vpe ? vpe->input : NULL;
+}
+
+int ohos_vpe_take_error(struct ohos_vpe *vpe)
+{
+    if (!vpe || vpe->fallback_queued)
+        return 0;
+    int error = atomic_load(&vpe->error);
+    if (!error)
+        return 0;
+    vpe->fallback_queued = true;
+    return error;
+}
diff --git a/video/out/ohos_vpe.h b/video/out/ohos_vpe.h
new file mode 100644
--- /dev/null
+++ b/video/out/ohos_vpe.h
@@ -0,0 +1,19 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+
+#include <stdbool.h>
+#include <native_window/external_window.h>
+
+struct mp_log;
+struct vo;
+struct ohos_vpe;
+
+// The caller retains the output window until after destroy. The processor owns
+// its input window; producers must be destroyed before the processor.
+struct ohos_vpe *ohos_vpe_create(struct mp_log *log, OHNativeWindow *output,
+                                int width, int height);
+OHNativeWindow *ohos_vpe_input(struct ohos_vpe *vpe);
+void ohos_vpe_destroy(struct ohos_vpe *vpe);
+void ohos_vpe_resize(struct ohos_vpe *vpe, int width, int height);
+int ohos_vpe_take_error(struct ohos_vpe *vpe);
+void ohos_vpe_check(struct ohos_vpe *vpe, struct vo *vo);
