diff --git a/audio/out/ohaudio_clock.h b/audio/out/ohaudio_clock.h
new file mode 100644
--- /dev/null
+++ b/audio/out/ohaudio_clock.h
@@ -0,0 +1,88 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdatomic.h>
+
+#define OHAUDIO_CLOCK_MAX_AGE_NS INT64_C(2000000000)
+
+// OHAudio uses CLOCK_MONOTONIC; mpv can use CLOCK_MONOTONIC_RAW with
+// an additional private origin. Map the sample's age, not its absolute value.
+static inline bool ohaudio_clock_translate(int64_t timestamp, int64_t mono_now,
+                                           int64_t mpv_now, int64_t *mapped)
+{
+    if (timestamp <= 0 || timestamp > mono_now)
+        return false;
+    int64_t age = mono_now - timestamp;
+    if (age >= OHAUDIO_CLOCK_MAX_AGE_NS || mpv_now <= age)
+        return false;
+    *mapped = mpv_now - age;
+    return true;
+}
+
+struct ohaudio_clock_sample {
+    uint64_t epoch;
+    int64_t position;
+    int64_t timestamp;
+    int64_t published_at;
+};
+
+struct ohaudio_clock_snapshot {
+    atomic_uint_fast64_t sequence;
+    atomic_uint_fast64_t epoch;
+    atomic_int_fast64_t position;
+    atomic_int_fast64_t timestamp;
+    atomic_int_fast64_t published_at;
+};
+
+static inline void ohaudio_clock_init(struct ohaudio_clock_snapshot *s)
+{
+    atomic_init(&s->sequence, 0);
+    atomic_init(&s->epoch, 0);
+    atomic_init(&s->position, 0);
+    atomic_init(&s->timestamp, 0);
+    atomic_init(&s->published_at, 0);
+}
+
+// Single background writer. Sequential consistency also orders the payload
+// with the sequence checks; using only an unchanged epoch cannot prevent tears.
+static inline void ohaudio_clock_publish(struct ohaudio_clock_snapshot *s,
+                                         struct ohaudio_clock_sample v)
+{
+    atomic_fetch_add(&s->sequence, 1);
+    atomic_store(&s->epoch, v.epoch);
+    atomic_store(&s->position, v.position);
+    atomic_store(&s->timestamp, v.timestamp);
+    atomic_store(&s->published_at, v.published_at);
+    atomic_fetch_add(&s->sequence, 1);
+}
+
+// One bounded attempt: the audio callback never waits or spins for the writer.
+// On contention the caller retains its last coherent sample.
+static inline bool ohaudio_clock_read(struct ohaudio_clock_snapshot *s,
+                                      struct ohaudio_clock_sample *out)
+{
+    uint64_t seq = atomic_load(&s->sequence);
+    if (seq & 1)
+        return false;
+    struct ohaudio_clock_sample value = {
+        .epoch = atomic_load(&s->epoch),
+        .position = atomic_load(&s->position),
+        .timestamp = atomic_load(&s->timestamp),
+        .published_at = atomic_load(&s->published_at),
+    };
+    if (atomic_load(&s->sequence) != seq)
+        return false;
+    *out = value;
+    return true;
+}
+
+static inline bool ohaudio_clock_valid(struct ohaudio_clock_sample s,
+                                       uint64_t epoch, int64_t now)
+{
+    return s.epoch == epoch && s.position >= 0 && s.timestamp > 0 &&
+           s.timestamp <= now && s.published_at <= now &&
+           now - s.published_at < OHAUDIO_CLOCK_MAX_AGE_NS &&
+           now - s.timestamp < OHAUDIO_CLOCK_MAX_AGE_NS;
+}
