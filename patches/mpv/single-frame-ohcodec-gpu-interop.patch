diff --git a/video/out/vo_gpu_next.c b/video/out/vo_gpu_next.c
index cfa74c74e7..9a03fde3f3 100644
--- a/video/out/vo_gpu_next.c
+++ b/video/out/vo_gpu_next.c
@@ -134,6 +134,10 @@ struct priv {
     bool is_interpolated;
     bool want_reset;
     bool frame_pending;
+    // OHCodec's NativeImage interop exposes one mutable external image. It
+    // cannot keep several independently addressable source frames alive for
+    // libplacebo's temporal mixer. Keep this path strictly single-frame.
+    bool single_image_hwdec;
 
     pl_options pars;
     struct m_config_cache *opts_cache;
@@ -1042,7 +1046,8 @@ static bool draw_frame(struct vo *vo, struct vo_frame *frame)
     const struct gl_video_opts *opts = p->opts_cache->opts;
     bool will_redraw = frame->display_synced && frame->num_vsyncs > 1;
     bool cache_frame = will_redraw || frame->still;
-    bool can_interpolate = opts->interpolation && frame->display_synced &&
+    bool can_interpolate = !p->single_image_hwdec && opts->interpolation &&
+                           frame->display_synced &&
                            !frame->still && frame->num_frames > 1;
     double pts_offset = can_interpolate ? frame->ideal_frame_vsync : 0;
     params.info_callback = info_callback;
@@ -1534,6 +1539,16 @@ static void resize(struct vo *vo)
 static int reconfig(struct vo *vo, struct mp_image_params *params)
 {
     struct priv *p = vo->priv;
+    bool single_image_hwdec = params->imgfmt == IMGFMT_OHCODEC;
+    if (single_image_hwdec != p->single_image_hwdec) {
+        p->single_image_hwdec = single_image_hwdec;
+        p->want_reset = true;
+        update_render_options(vo);
+        if (single_image_hwdec) {
+            MP_INFO(vo, "OHCodec single-image interop: temporal mixing "
+                    "disabled, decoder queue depth=1\n");
+        }
+    }
     if (!p->ra_ctx->fns->reconfig(p->ra_ctx))
         return -1;
 
@@ -2548,13 +2563,14 @@ static void update_render_options(struct vo *vo)
     pars->params.upscaler = map_scaler(p, SCALER_SCALE);
     pars->params.downscaler = map_scaler(p, SCALER_DSCALE);
     pars->params.plane_upscaler = map_scaler(p, SCALER_CSCALE);
-    pars->params.frame_mixer = opts->interpolation ? map_scaler(p, SCALER_TSCALE) : NULL;
+    pars->params.frame_mixer = opts->interpolation && !p->single_image_hwdec
+                            ? map_scaler(p, SCALER_TSCALE) : NULL;
 
     // Request as many frames as required from the decoder, depending on the
     // speed VPS/FPS ratio libplacebo may need more frames. Request frames up to
     // ratio of 1/2, but only if anti aliasing is enabled.
-    int req_frames = 2;
-    if (pars->params.frame_mixer) {
+    int req_frames = p->single_image_hwdec ? 1 : 2;
+    if (!p->single_image_hwdec && pars->params.frame_mixer) {
         req_frames += ceilf(pars->params.frame_mixer->kernel->radius) *
                       (pars->params.skip_anti_aliasing ? 1 : 2);
     }
