+bool vo_ohos_prepare_output(struct vo *vo, int pixel_format)
+{
+    struct vo_ohos_state *ctx = vo->ohos;
+    if (!vo->opts->ohos_super_resolution)
+        return true;
+    int w, h;
+    if (!vo_ohos_surface_size(vo, &w, &h))
+        return false;
+    struct pl_color_space color = vo_ohos_preferred_csp(vo);
+    ctx->vpe = ohos_vpe_create_configured(vo->log, ctx->display_window, w, h,
+                              pixel_format, get_color_space(&color));
+    if (!ctx->vpe)
+        return false;
+    ctx->native_window = ohos_vpe_input(ctx->vpe);
+    ohos_vpe_attach(ctx->vpe, vo);
+    // Both windows exist now; publish matching HDR metadata before Start can
+    // allocate any buffers. EGL will bind the already configured input next.
+    set_output_color(ctx, color);
+    return ohos_vpe_start(ctx->vpe);
