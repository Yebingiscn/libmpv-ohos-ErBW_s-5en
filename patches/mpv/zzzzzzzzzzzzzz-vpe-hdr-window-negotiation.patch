+bool ohos_vpe_start(struct ohos_vpe *vpe)
+{
+    if (!vpe || vpe->running)
+        return vpe && vpe->running;
+    int ret = OH_VideoProcessing_Start(vpe->processor);
+    if (ret) {
+        mp_warn(vpe->log, "[SuperResolution] Start failed: %d\n", ret);
+        return false;
+    }
+    vpe->running = true;
+    if (mp_thread_create(&vpe->worker, output_worker, vpe)) {
+        mp_warn(vpe->log, "[SuperResolution] Output worker creation failed\n");
+        return false;
+    }
+    vpe->worker_created = true;
+    mp_warn(vpe->log, "[SuperResolution] VPE high quality started after Surface configuration\n");
