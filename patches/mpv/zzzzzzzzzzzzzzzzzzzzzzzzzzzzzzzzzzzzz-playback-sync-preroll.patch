+void mp_decoder_wrapper_set_playback_sync(struct mp_decoder_wrapper *d, bool active)
+{
+    struct priv *p = d->f->priv;
+    mp_mutex_lock(&p->cache_lock);
+    bool changed = p->playback_sync != active;
+    p->playback_sync = active;
+    mp_mutex_unlock(&p->cache_lock);
+    // Publish the hint even when the output queue is full or input is empty.
+    // Platform policy is applied on the next decoder receive call.
+    // Unlike thread_lock(), this never waits for hardware decoding to finish.
+    if (changed)
+        mp_filter_wakeup(p->decf);
+}
