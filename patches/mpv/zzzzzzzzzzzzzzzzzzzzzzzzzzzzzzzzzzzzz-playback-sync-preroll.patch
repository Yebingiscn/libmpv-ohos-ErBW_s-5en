+// Track re-enabling has a moving sync target in video_output_image(), unlike
+// an explicit seek's decoder start_pts. Keep preroll demand until the player
+// has submitted a current frame, including lookahead and VO reconfiguration.
+static void update_playback_sync(struct MPContext *mpctx)
+{
+    struct vo_chain *vo_c = mpctx->vo_chain;
+    if (!vo_c || !vo_c->track || !vo_c->track->dec)
+        return;
+    bool active = mpctx->video_status == STATUS_SYNCING &&
+                  mpctx->audio_status == STATUS_PLAYING &&
+                  mpctx->playback_pts != MP_NOPTS_VALUE &&
+                  !mpctx->hrseek_active && mpctx->play_dir > 0 &&
+                  !vo_c->is_sparse;
+    mp_decoder_wrapper_set_playback_sync(vo_c->track->dec, active);
+}
