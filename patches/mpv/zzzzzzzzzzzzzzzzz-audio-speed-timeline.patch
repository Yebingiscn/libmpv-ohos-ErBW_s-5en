+// Keep the change scoped to the timestamped OHAudio PCM path.
+static bool use_output_timeline(struct MPContext *mpctx)
+{
+    if (!mpctx->ao || !mpctx->ao_chain ||
+        mpctx->ao_chain->ao != mpctx->ao ||
+        strcmp(ao_get_name(mpctx->ao), "ohaudio"))
+        return false;
+    int rate, format;
+    struct mp_chmap channels;
+    ao_get_format(mpctx->ao, &rate, &format, &channels);
+    return af_fmt_is_pcm(format);
+}
+
+bool audio_timeline_frame_wait(struct MPContext *mpctx, double delay, double *wait)
+{
+    if (!use_output_timeline(mpctx))
+        return false;
+    struct ao_chain *ao_c = mpctx->ao_chain;
+    bool valid = audio_timeline_wait(&ao_c->output_timeline, delay,
+                                     ao_c->last_out_pts - mpctx->delay, wait);
+    if (mp_msg_test(mpctx->log, MSGL_DEBUG)) {
+        int64_t now = mp_time_ns();
+        if (now - ao_c->timeline_log_ns >= MP_TIME_MS_TO_NS(250)) {
+            double pts = MP_NOPTS_VALUE;
+            audio_timeline_pts(&ao_c->output_timeline, delay, &pts);
+            MP_DBG(mpctx, "[Perf] audio-timeline monoNs=%lld speed=%.3f aoDelay=%.6f writtenPts=%.6f playingPts=%.6f frameWait=%.6f valid=%d segments=%u\n",
+                   (long long)now, mpctx->audio_speed, delay, ao_c->last_out_pts,
+                   pts, valid ? *wait : 0.0, valid, ao_c->output_timeline.count);
+            ao_c->timeline_log_ns = now;
+        }
+    }
+    return valid;
+}
