diff --git a/audio/output_timeline.h b/audio/output_timeline.h
new file mode 100644
--- /dev/null
+++ b/audio/output_timeline.h
@@ -0,0 +1,118 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+
+#include <math.h>
+#include <stdbool.h>
+
+#define AUDIO_TIMELINE_CAPACITY 256
+
+// Core-thread-only mapping from submitted PCM duration to media timestamps.
+// Adjacent frames with identical speed are merged. No callback work/allocation.
+struct audio_timeline_segment {
+    double start, end;
+    double pts, speed;
+};
+
+struct audio_output_timeline {
+    struct audio_timeline_segment segments[AUDIO_TIMELINE_CAPACITY];
+    unsigned first, count;
+    double written;
+};
+
+static inline void audio_timeline_reset(struct audio_output_timeline *t)
+{
+    t->first = t->count = 0;
+    t->written = 0;
+}
+
+static inline void audio_timeline_append(struct audio_output_timeline *t,
+                                         double duration, double pts, double speed)
+{
+    if (!isfinite(duration) || duration <= 0 || !isfinite(pts) ||
+        !isfinite(speed) || speed <= 0) {
+        audio_timeline_reset(t);
+        return;
+    }
+    double end = t->written + duration;
+    if (t->count) {
+        struct audio_timeline_segment *last =
+            &t->segments[(t->first + t->count - 1) % AUDIO_TIMELINE_CAPACITY];
+        double last_pts = last->pts + (last->end - last->start) * last->speed;
+        if (fabs(last->speed - speed) < 1e-12 && fabs(last_pts - pts) < 1e-7) {
+            last->end = end;
+            t->written = end;
+            return;
+        }
+    }
+    if (t->count == AUDIO_TIMELINE_CAPACITY) {
+        t->first = (t->first + 1) % AUDIO_TIMELINE_CAPACITY;
+        --t->count;
+    }
+    struct audio_timeline_segment *s =
+        &t->segments[(t->first + t->count++) % AUDIO_TIMELINE_CAPACITY];
+    s->start = t->written;
+    s->end = end;
+    s->pts = pts;
+    s->speed = speed;
+    t->written = end;
+}
+
+static inline bool audio_timeline_pts(const struct audio_output_timeline *t,
+                                      double delay, double *pts)
+{
+    if (!t->count || !isfinite(delay) || delay < 0)
+        return false;
+    double played = t->written - delay;
+    for (unsigned i = t->count; i > 0; --i) {
+        const struct audio_timeline_segment *s =
+            &t->segments[(t->first + i - 1) % AUDIO_TIMELINE_CAPACITY];
+        if (played >= s->start - 1e-9 && played <= s->end + 1e-9) {
+            *pts = s->pts + (fmax(s->start, fmin(played, s->end)) - s->start) * s->speed;
+            return true;
+        }
+    }
+    // History was evicted, invalid, or belongs to a previous gapless stream.
+    return false;
+}
+
+static inline bool audio_timeline_wait(const struct audio_output_timeline *t,
+                                       double delay, double target_pts, double *wait)
+{
+    double current_pts;
+    if (!isfinite(target_pts) || !audio_timeline_pts(t, delay, &current_pts))
+        return false;
+    double played = t->written - delay;
+    // Resolve against the segment currently being played first; then look
+    // forward/backward only across contiguous PTS. Never bridge a timestamp gap.
+    unsigned current = 0;
+    for (unsigned i = 0; i < t->count; ++i) {
+        const struct audio_timeline_segment *s =
+            &t->segments[(t->first + i) % AUDIO_TIMELINE_CAPACITY];
+        if (played >= s->start - 1e-9)
+            current = i;
+    }
+    int direction = target_pts >= current_pts ? 1 : -1;
+    for (int i = (int)current; i >= 0 && i < (int)t->count; i += direction) {
+        const struct audio_timeline_segment *s =
+            &t->segments[(t->first + i) % AUDIO_TIMELINE_CAPACITY];
+        double end_pts = s->pts + (s->end - s->start) * s->speed;
+        if (target_pts >= s->pts - 1e-9 && target_pts <= end_pts + 1e-9) {
+            *wait = s->start + (target_pts - s->pts) / s->speed - played;
+            return true;
+        }
+        int next = i + direction;
+        if (next < 0 || next >= (int)t->count) {
+            // A nearby video frame may lie just beyond available audio. Use
+            // this edge segment's speed, never the newly requested speed.
+            *wait = s->start + (target_pts - s->pts) / s->speed - played;
+            return true;
+        }
+        const struct audio_timeline_segment *n =
+            &t->segments[(t->first + next) % AUDIO_TIMELINE_CAPACITY];
+        double boundary = direction > 0 ? end_pts - n->pts :
+            n->pts + (n->end - n->start) * n->speed - s->pts;
+        if (fabs(boundary) > 1e-7)
+            return false;
+    }
+    return false;
+}
