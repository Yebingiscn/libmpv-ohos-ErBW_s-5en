+static OH_AudioNode_Type suite_node_type(int effect)
+{
+    switch (effect) {
+    case SUITE_EFFECT_EQUALIZER:            return EFFECT_NODE_TYPE_EQUALIZER;
+    case SUITE_EFFECT_NOISE_REDUCTION:      return EFFECT_NODE_TYPE_NOISE_REDUCTION;
+    case SUITE_EFFECT_SOUND_FIELD:          return EFFECT_NODE_TYPE_SOUND_FIELD;
+    case SUITE_EFFECT_AUDIO_SEPARATION:
+        return EFFECT_MULTII_OUTPUT_NODE_TYPE_AUDIO_SEPARATION;
+    case SUITE_EFFECT_VOICE_BEAUTIFIER:     return EFFECT_NODE_TYPE_VOICE_BEAUTIFIER;
+    case SUITE_EFFECT_ENVIRONMENT:          return EFFECT_NODE_TYPE_ENVIRONMENT_EFFECT;
+    case SUITE_EFFECT_AUDIO_MIXER:          return EFFECT_NODE_TYPE_AUDIO_MIXER;
+    case SUITE_EFFECT_SPACE_RENDER:         return EFFECT_NODE_TYPE_SPACE_RENDER;
+    case SUITE_EFFECT_PURE_VOICE_CHANGE:    return EFFECT_NODE_TYPE_PURE_VOICE_CHANGE;
+    case SUITE_EFFECT_GENERAL_VOICE_CHANGE: return EFFECT_NODE_TYPE_GENERAL_VOICE_CHANGE;
+    case SUITE_EFFECT_TEMPO_PITCH:          return EFFECT_NODE_TYPE_TEMPO_PITCH;
+    case SUITE_EFFECT_HOA_SPACE_RENDER:     return EFFECT_NODE_TYPE_HOA_SPACE_RENDER;
+    default:                                return INPUT_NODE_TYPE_DEFAULT;
+    }
+}
+
+static OH_AudioChannelLayout suite_hoa_layout(int layout, int *channels)
+{
+    static const OH_AudioChannelLayout layouts[] = {
+        CH_LAYOUT_AMB_ORDER1_ACN_N3D,
+        CH_LAYOUT_AMB_ORDER1_ACN_SN3D,
+        CH_LAYOUT_AMB_ORDER1_FUMA,
+        CH_LAYOUT_AMB_ORDER2_ACN_N3D,
+        CH_LAYOUT_AMB_ORDER2_ACN_SN3D,
+        CH_LAYOUT_AMB_ORDER2_FUMA,
+        CH_LAYOUT_AMB_ORDER3_ACN_N3D,
+        CH_LAYOUT_AMB_ORDER3_ACN_SN3D,
+        CH_LAYOUT_AMB_ORDER3_FUMA,
+    };
+    layout = MPCLAMP(layout, 0, (int)MP_ARRAY_SIZE(layouts) - 1);
+    *channels = layout < 3 ? 4 : layout < 6 ? 9 : 16;
+    return layouts[layout];
+}
