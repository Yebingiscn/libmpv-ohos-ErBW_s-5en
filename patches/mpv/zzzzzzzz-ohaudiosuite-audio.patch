+static int render_audio_suite(struct ao *ao, void *audio_data,
+                              int32_t audio_data_size)
+{
+    struct priv *p = ao->priv;
+    int32_t response_size = 0;
+    bool finished = false;
+    OH_AudioSuite_Result res;
+
+    if (p->suite_effect == SUITE_EFFECT_AUDIO_SEPARATION) {
+        if (!p->suite_scratch || audio_data_size > SUITE_SCRATCH_SIZE)
+            return 0;
+
+        void *outputs[2];
+        if (p->suite_separation_output == SUITE_SEPARATION_ACCOMPANIMENT) {
+            outputs[0] = p->suite_scratch;
+            outputs[1] = audio_data;
+        } else {
+            outputs[0] = audio_data;
+            outputs[1] = p->suite_scratch;
+        }
+        OH_AudioDataArray array = {
+            .audioDataArray = outputs,
+            .arraySize = 2,
+            .requestFrameSize = audio_data_size,
+        };
+        res = OH_AudioSuiteEngine_MultiRenderFrame(p->suite_pipeline, &array,
+                                                   &response_size, &finished);
+        if (res == AUDIOSUITE_SUCCESS &&
+            p->suite_separation_output == SUITE_SEPARATION_MIX)
+        {
+            float *vocals = audio_data;
+            float *accompaniment = p->suite_scratch;
+            for (int n = 0; n < response_size / (int)sizeof(float); n++) {
+                float sample = vocals[n] + accompaniment[n];
+                vocals[n] = MPCLAMP(sample, -1.0f, 1.0f);
+            }
+        }
+    } else {
+        res = OH_AudioSuiteEngine_RenderFrame(p->suite_pipeline, audio_data,
+                                              audio_data_size, &response_size,
+                                              &finished);
+    }
