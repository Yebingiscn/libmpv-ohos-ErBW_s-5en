+static OH_Audio_SampleFormat suite_sample_format(int format)
+{
+    switch (format) {
+    case AF_FORMAT_U8:    return AUDIO_SAMPLE_U8;
+    case AF_FORMAT_S32:   return AUDIO_SAMPLE_S32LE;
+    case AF_FORMAT_FLOAT: return AUDIO_SAMPLE_F32LE;
+    default:              return AUDIO_SAMPLE_S16LE;
+    }
+}
+
+static OH_AudioStream_SampleFormat stream_sample_format(int format)
+{
+    switch (format) {
+    case AF_FORMAT_U8:    return AUDIOSTREAM_SAMPLE_U8;
+    case AF_FORMAT_S32:   return AUDIOSTREAM_SAMPLE_S32LE;
+    case AF_FORMAT_FLOAT: return AUDIOSTREAM_SAMPLE_F32LE;
+    default:              return AUDIOSTREAM_SAMPLE_S16LE;
+    }
+}
