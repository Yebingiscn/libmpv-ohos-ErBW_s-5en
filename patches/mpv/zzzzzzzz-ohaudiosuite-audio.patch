+static const char *suite_effect_name(int effect)
+{
+    switch (effect) {
+    case SUITE_EFFECT_EQUALIZER:           return "equalizer";
+    case SUITE_EFFECT_NOISE_REDUCTION:     return "noise-reduction";
+    case SUITE_EFFECT_SOUND_FIELD:         return "sound-field";
+    case SUITE_EFFECT_AUDIO_SEPARATION:    return "audio-separation";
+    case SUITE_EFFECT_VOICE_BEAUTIFIER:    return "voice-beautifier";
+    case SUITE_EFFECT_ENVIRONMENT:         return "environment";
+    case SUITE_EFFECT_AUDIO_MIXER:         return "audio-mixer";
+    case SUITE_EFFECT_SPACE_RENDER:        return "space-render";
+    case SUITE_EFFECT_PURE_VOICE_CHANGE:   return "pure-voice-change";
+    case SUITE_EFFECT_GENERAL_VOICE_CHANGE:return "general-voice-change";
+    case SUITE_EFFECT_TEMPO_PITCH:         return "tempo-pitch";
+    case SUITE_EFFECT_HOA_SPACE_RENDER:    return "hoa-space-render";
+    default:                               return "off";
+    }
+}
