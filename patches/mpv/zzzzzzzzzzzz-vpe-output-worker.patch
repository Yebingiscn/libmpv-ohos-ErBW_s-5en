+    unsigned head, count;
+    bool first_output;
+    int64_t first_input;
+    void (*notify)(void *);
+    void *notify_data;
 };
 
+// lock held; destroy disables notification before the VO can be released.
+static void notify_error(struct ohos_vpe *vpe)
+{
+    if (!vpe->shutdown && vpe->notify)
+        vpe->notify(vpe->notify_data);
+}
+
+void ohos_vpe_set_wakeup(struct ohos_vpe *vpe, void (*wakeup)(void *), void *data)
+{
+    if (!vpe) return;
+    mp_mutex_lock(&vpe->lock);
+    vpe->notify = wakeup;
+    vpe->notify_data = data;
+    if (atomic_load(&vpe->error)) notify_error(vpe);
+    mp_mutex_unlock(&vpe->lock);
+}
+
 static void on_error(OH_VideoProcessing *processor,
                      VideoProcessing_ErrorCode error, void *data)
 {
     struct ohos_vpe *vpe = data;
     atomic_store(&vpe->error, error);
+    mp_mutex_lock(&vpe->lock);
+    notify_error(vpe);
+    mp_mutex_unlock(&vpe->lock);
 }
 
 static void on_output(OH_VideoProcessing *processor, uint32_t index, void *data)
 {
     struct ohos_vpe *vpe = data;
-    int ret = OH_VideoProcessing_RenderOutputBuffer(processor, index);
-    if (ret != VIDEO_PROCESSING_SUCCESS)
-        atomic_store(&vpe->error, ret);
+    // Vendor callbacks only enqueue tokens. Never re-enter VPE from here.
+    mp_mutex_lock(&vpe->lock);
+    if (!vpe->shutdown) {
+        if (vpe->count == OUTPUT_QUEUE_SIZE) {
+            atomic_store(&vpe->error, VIDEO_PROCESSING_ERROR_PROCESS_FAILED);
+            notify_error(vpe);
+        } else {
+            vpe->queue[(vpe->head + vpe->count++) % OUTPUT_QUEUE_SIZE] = index;
+            mp_cond_signal(&vpe->wakeup);
+        }
+    }
+    mp_mutex_unlock(&vpe->lock);
+}
+
+static MP_THREAD_VOID output_worker(void *data)
+{
+    struct ohos_vpe *vpe = data;
+    mp_mutex_lock(&vpe->lock);
+    while (!vpe->shutdown) {
+        if (vpe->count) {
+            uint32_t index = vpe->queue[vpe->head];
+            vpe->head = (vpe->head + 1) % OUTPUT_QUEUE_SIZE;
+            vpe->count--;
+            mp_mutex_unlock(&vpe->lock);
+            int ret = OH_VideoProcessing_RenderOutputBuffer(vpe->processor, index);
+            mp_mutex_lock(&vpe->lock);
+            if (ret) {
+                atomic_store(&vpe->error, ret);
+                notify_error(vpe);
+            } else if (!vpe->first_output) {
+                vpe->first_output = true;
+                mp_warn(vpe->log, "[SuperResolution] First output submitted\n");
+            }
+            continue;
+        }
+        if (vpe->first_input && !vpe->first_output && !atomic_load(&vpe->error)) {
+            int64_t left = FIRST_OUTPUT_TIMEOUT_NS - (mp_time_ns() - vpe->first_input);
+            if (left <= 0) {
+                atomic_store(&vpe->error, VIDEO_PROCESSING_ERROR_PROCESS_FAILED);
+                notify_error(vpe);
+                mp_warn(vpe->log, "[SuperResolution] No first output; requesting normal output\n");
+                continue;
+            }
+            mp_cond_timedwait(&vpe->wakeup, &vpe->lock, left);
+        } else {
+            mp_cond_wait(&vpe->wakeup, &vpe->lock);
+        }
+    }
+    mp_mutex_unlock(&vpe->lock);
+    MP_THREAD_RETURN();
+}
+
+void ohos_vpe_note_input(struct ohos_vpe *vpe)
+{
+    if (!vpe)
+        return;
+    mp_mutex_lock(&vpe->lock);
+    if (!vpe->first_input && !vpe->first_output) {
+        vpe->first_input = mp_time_ns();
+        mp_cond_signal(&vpe->wakeup);
+    }
+    mp_mutex_unlock(&vpe->lock);
+}
+
+void ohos_vpe_stop_output(struct ohos_vpe *vpe)
+{
+    if (!vpe)
+        return;
+    mp_mutex_lock(&vpe->lock);
+    vpe->shutdown = true;
+    mp_cond_signal(&vpe->wakeup);
+    mp_mutex_unlock(&vpe->lock);
+    if (vpe->worker_created) {
+        mp_thread_join(vpe->worker);
+        vpe->worker_created = false;
+    }
 }
 
 void ohos_vpe_destroy(struct ohos_vpe *vpe)
 {
     if (!vpe)
         return;
+    ohos_vpe_stop_output(vpe);
     // Never release callback user data until the vendor instance is destroyed.
     if (vpe->running)
         OH_VideoProcessing_Stop(vpe->processor);
