diff --git a/video/out/opengl/context_ohos.c b/video/out/opengl/context_ohos.c
index a0e1c16626..424b93a219 100644
--- a/video/out/opengl/context_ohos.c
+++ b/video/out/opengl/context_ohos.c
@@ -147,6 +147,9 @@ static bool ohos_reconfig(struct ra_ctx *ctx)
     if (!vo_ohos_surface_size(ctx->vo, &w, &h))
         return false;
 
+    if (!vo_ohos_set_surface_size(ctx->vo, w, h))
+        return false;
+
     ctx->vo->dwidth = w;
     ctx->vo->dheight = h;
     ra_gl_ctx_resize(ctx->swapchain, w, h, 0);
diff --git a/video/out/vulkan/context_ohos.c b/video/out/vulkan/context_ohos.c
