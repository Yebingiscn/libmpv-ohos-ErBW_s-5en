diff --git a/video/out/ohos_common.c b/video/out/ohos_common.c
index 0392b1e57a..49d8c32685 100644
--- a/video/out/ohos_common.c
+++ b/video/out/ohos_common.c
@@ -432,6 +432,23 @@ bool vo_ohos_surface_size(struct vo *vo, int *out_w, int *out_h)
     return true;
 }
 
+bool vo_ohos_set_surface_size(struct vo *vo, int w, int h)
+{
+    struct vo_ohos_state *ctx = vo->ohos;
+    if (!ctx || !ctx->native_window || w <= 0 || h <= 0)
+        return false;
+
+    int ret = OH_NativeWindow_NativeWindowHandleOpt(
+        ctx->native_window, SET_BUFFER_GEOMETRY, w, h);
+    if (ret != 0) {
+        MP_ERR(ctx, "Failed to resize NativeWindow buffers to %dx%d: %d\n",
+               w, h, ret);
+        return false;
+    }
+
+    return true;
+}
+
 struct pl_color_space vo_ohos_preferred_csp(struct vo *vo)
 {
     const struct pl_color_space color = vo_get_current_params(vo).color;
