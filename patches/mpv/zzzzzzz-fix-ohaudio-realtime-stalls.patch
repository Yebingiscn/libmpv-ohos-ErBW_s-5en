+static void set_clock_running(struct priv *p, bool running)
+{
+    if (!p->clock_sync_initialized)
+        return;
+
+    mp_mutex_lock(&p->clock_lock);
+    if (!p->clock_shutdown) {
+        atomic_fetch_add_explicit(&p->clock_epoch, 1, memory_order_acq_rel);
+        atomic_store_explicit(&p->clock_running, running, memory_order_release);
+        mp_cond_signal(&p->clock_wakeup);
+    }
+    mp_mutex_unlock(&p->clock_lock);
+}
+
+static void report_stats(struct ao *ao)
+{
+    struct priv *p = ao->priv;
+    uint64_t callbacks = atomic_exchange_explicit(&p->callback_count, 0,
+                                                   memory_order_relaxed);
+    uint64_t callback_total = atomic_exchange_explicit(&p->callback_total_ns, 0,
+                                                        memory_order_relaxed);
+    uint64_t callback_max = atomic_exchange_explicit(&p->callback_max_ns, 0,
+                                                      memory_order_relaxed);
+    uint64_t read_total = atomic_exchange_explicit(&p->read_total_ns, 0,
+                                                    memory_order_relaxed);
+    uint64_t read_max = atomic_exchange_explicit(&p->read_max_ns, 0,
+                                                  memory_order_relaxed);
+    uint64_t contentions = atomic_exchange_explicit(&p->lock_contentions, 0,
+                                                     memory_order_relaxed);
+    uint64_t short_reads = atomic_exchange_explicit(&p->short_reads, 0,
+                                                     memory_order_relaxed);
+    uint64_t queries = atomic_exchange_explicit(&p->query_count, 0,
+                                                 memory_order_relaxed);
+    uint64_t query_total = atomic_exchange_explicit(&p->query_total_ns, 0,
+                                                     memory_order_relaxed);
+    uint64_t query_max = atomic_exchange_explicit(&p->query_max_ns, 0,
+                                                   memory_order_relaxed);
+    uint64_t query_failures = atomic_exchange_explicit(&p->query_failures, 0,
+                                                        memory_order_relaxed);
+
+    if (!callbacks && !queries)
+        return;
+
+    bool slow = callback_max >= CALLBACK_WARN_NS ||
+                read_max >= CALLBACK_WARN_NS ||
+                query_max >= CLOCK_QUERY_WARN_NS || contentions ||
+                short_reads || query_failures;
+    int level = slow ? MSGL_WARN : MSGL_TRACE;
+    mp_msg(ao->log, level,
+           "OHAudio 10s: cb=%llu avg/max=%.3f/%.3f ms, "
+           "read avg/max=%.3f/%.3f ms, lock-miss=%llu short=%llu, "
+           "clock=%llu avg/max=%.3f/%.3f ms fail=%llu\n",
+           (unsigned long long)callbacks,
+           callbacks ? callback_total / 1e6 / callbacks : 0.0,
+           callback_max / 1e6,
+           callbacks ? read_total / 1e6 / callbacks : 0.0,
+           read_max / 1e6,
+           (unsigned long long)contentions,
+           (unsigned long long)short_reads,
+           (unsigned long long)queries,
+           queries ? query_total / 1e6 / queries : 0.0,
+           query_max / 1e6,
+           (unsigned long long)query_failures);
+}
+
+static MP_THREAD_VOID clock_thread(void *arg)
+{
+    struct ao *ao = arg;
+    struct priv *p = ao->priv;
+    int64_t next_report = mp_time_ns() + STATS_REPORT_INTERVAL_NS;
+
+    mp_thread_set_name("ohaudio-clock");
+    mp_mutex_lock(&p->clock_lock);
+    while (!p->clock_shutdown) {
+        while (!p->clock_shutdown &&
+               !atomic_load_explicit(&p->clock_running, memory_order_acquire))
+            mp_cond_wait(&p->clock_wakeup, &p->clock_lock);
+
+        if (p->clock_shutdown)
+            break;
+
+        uint64_t epoch = atomic_load_explicit(&p->clock_epoch,
+                                               memory_order_acquire);
+        mp_mutex_unlock(&p->clock_lock);
+
+        int64_t position = 0;
+        int64_t timestamp = 0;
+        int64_t query_start = mp_time_ns();
+        OH_AudioStream_Result res = OH_AudioRenderer_GetAudioTimestampInfo(
+            p->renderer, &position, &timestamp);
+        int64_t now = mp_time_ns();
+        uint64_t query_ns = now - query_start;
+
+        atomic_fetch_add_explicit(&p->query_count, 1, memory_order_relaxed);
+        atomic_fetch_add_explicit(&p->query_total_ns, query_ns,
+                                  memory_order_relaxed);
+        atomic_update_max(&p->query_max_ns, query_ns);
+
+        bool valid = res == AUDIOSTREAM_SUCCESS && position >= 0 &&
+                     timestamp > 0 && timestamp <= now &&
+                     now - timestamp < MP_TIME_S_TO_NS(2);
+        if (!valid) {
+            atomic_fetch_add_explicit(&p->query_failures, 1,
+                                      memory_order_relaxed);
+        } else if (atomic_load_explicit(&p->clock_running,
+                                        memory_order_acquire) &&
+                   atomic_load_explicit(&p->clock_epoch,
+                                        memory_order_acquire) == epoch)
+        {
+            atomic_store_explicit(&p->snapshot_position, position,
+                                  memory_order_relaxed);
+            atomic_store_explicit(&p->snapshot_timestamp, timestamp,
+                                  memory_order_relaxed);
+            atomic_store_explicit(&p->snapshot_published_at, now,
+                                  memory_order_relaxed);
+            atomic_store_explicit(&p->snapshot_epoch, epoch,
+                                  memory_order_release);
+        }
+
+        if (now >= next_report) {
+            report_stats(ao);
+            next_report = now + STATS_REPORT_INTERVAL_NS;
+        }
+
+        mp_mutex_lock(&p->clock_lock);
+        if (!p->clock_shutdown &&
+            atomic_load_explicit(&p->clock_running, memory_order_acquire))
+        {
+            mp_cond_timedwait(&p->clock_wakeup, &p->clock_lock,
+                              CLOCK_QUERY_INTERVAL_NS);
+        }
+    }
+    mp_mutex_unlock(&p->clock_lock);
+
+    report_stats(ao);
+    MP_THREAD_RETURN();
+}
+
+static bool start_clock_thread(struct ao *ao)
+{
+    struct priv *p = ao->priv;
+
+    if (mp_mutex_init(&p->clock_lock))
+        return false;
+    if (mp_cond_init(&p->clock_wakeup)) {
+        mp_mutex_destroy(&p->clock_lock);
+        return false;
+    }
+    p->clock_sync_initialized = true;
+
+    if (mp_thread_create(&p->clock_thread, clock_thread, ao))
+        return false;
+    p->clock_thread_created = true;
+    return true;
+}
+
+static void stop_clock_thread(struct priv *p)
+{
+    if (p->clock_thread_created) {
+        mp_mutex_lock(&p->clock_lock);
+        p->clock_shutdown = true;
+        atomic_store_explicit(&p->clock_running, false, memory_order_release);
+        mp_cond_signal(&p->clock_wakeup);
+        mp_mutex_unlock(&p->clock_lock);
+        mp_thread_join(p->clock_thread);
+        p->clock_thread_created = false;
+    }
+
+    if (p->clock_sync_initialized) {
+        mp_cond_destroy(&p->clock_wakeup);
+        mp_mutex_destroy(&p->clock_lock);
+        p->clock_sync_initialized = false;
+    }
+}
+
 static void uninit(struct ao* ao)
 {
     struct priv* p = ao->priv;
 
+    stop_clock_thread(p);
+
     if (p->renderer) {
         uint32_t underflows;
         if (OH_AudioRenderer_GetUnderflowCount(p->renderer, &underflows) ==
@@ -70,11 +312,9 @@ static void uninit(struct ao* ao)
         OH_AudioStreamBuilder_Destroy(p->builder);
         p->builder = NULL;
     }
-
-    reset_timing(p);
 }
 
