+static void init_timing(struct priv *p)
 {
-    p->last_query = 0;
+    atomic_init(&p->clock_running, false);
+    atomic_init(&p->stream_epoch, 1);
+    atomic_init(&p->clock_epoch, 1);
+    atomic_init(&p->snapshot_epoch, 0);
+    atomic_init(&p->snapshot_position, 0);
+    atomic_init(&p->snapshot_timestamp, 0);
+    atomic_init(&p->snapshot_published_at, 0);
+
+    atomic_init(&p->callback_count, 0);
+    atomic_init(&p->callback_total_ns, 0);
+    atomic_init(&p->callback_max_ns, 0);
+    atomic_init(&p->read_total_ns, 0);
+    atomic_init(&p->read_max_ns, 0);
+    atomic_init(&p->lock_contentions, 0);
+    atomic_init(&p->short_reads, 0);
+    atomic_init(&p->query_count, 0);
+    atomic_init(&p->query_total_ns, 0);
+    atomic_init(&p->query_max_ns, 0);
