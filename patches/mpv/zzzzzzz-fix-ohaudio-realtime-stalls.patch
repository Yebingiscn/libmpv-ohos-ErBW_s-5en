diff --git a/audio/out/buffer.c b/audio/out/buffer.c
index 277b52410d..272324d088 100644
--- a/audio/out/buffer.c
+++ b/audio/out/buffer.c
@@ -204,13 +204,29 @@ static int ao_read_data_locked(struct ao *ao, void **data, int samples,
 // If this is called in paused mode, it will always return 0.
 // The caller should set out_time_ns to the expected delay until the last sample
 // reaches the speakers, in nanoseconds, using mp_time_ns() as reference.
-int ao_read_data(struct ao *ao, void **data, int samples, int64_t out_time_ns, bool *eof, bool pad_silence, bool blocking)
+static int ao_read_data_impl(struct ao *ao, void **data, int samples,
+                             int64_t out_time_ns, bool *eof,
+                             bool pad_silence, bool blocking,
+                             bool *lock_contended)
 {
     struct buffer_state *p = ao->buffer_state;
 
+    if (lock_contended)
+        *lock_contended = false;
+
     if (blocking) {
         mp_mutex_lock(&p->lock);
     } else if (mp_mutex_trylock(&p->lock)) {
+        if (lock_contended)
+            *lock_contended = true;
+        if (eof)
+            *eof = false;
+        // A pull callback must never return an uninitialized device buffer.
+        // On contention, emit silence and let the next callback retry.
+        if (pad_silence && data) {
+            for (int n = 0; n < ao->num_planes; n++)
+                af_fill_silence(data[n], samples * ao->sstride, ao->format);
+        }
         return 0;
     }
 
@@ -227,6 +243,21 @@ int ao_read_data(struct ao *ao, void **data, int samples, int64_t out_time_ns, b
     return pos;
 }
 
