 #include "osdep/timer.h"
 
+#include <stdatomic.h>
+
 #include <ohaudio/native_audiorenderer.h>
 #include <ohaudio/native_audiostreambuilder.h>
 
+#define CLOCK_QUERY_INTERVAL_NS MP_TIME_MS_TO_NS(250)
+#define STATS_REPORT_INTERVAL_NS MP_TIME_S_TO_NS(10)
+#define CALLBACK_WARN_NS MP_TIME_MS_TO_NS(5)
+#define CLOCK_QUERY_WARN_NS MP_TIME_MS_TO_NS(20)
+
 struct priv {
     OH_AudioStreamBuilder* builder;
     OH_AudioRenderer *renderer;
-    int64_t last_query;
+
+    mp_thread clock_thread;
+    mp_mutex clock_lock;
+    mp_cond clock_wakeup;
+    bool clock_sync_initialized;
+    bool clock_thread_created;
+    bool clock_shutdown;
+
+    atomic_bool clock_running;
+    atomic_uint_fast64_t stream_epoch;
+    atomic_uint_fast64_t clock_epoch;
+    atomic_uint_fast64_t snapshot_epoch;
+    atomic_int_fast64_t snapshot_position;
+    atomic_int_fast64_t snapshot_timestamp;
+    atomic_int_fast64_t snapshot_published_at;
+
+    // Accessed only by the OHAudio write callback.
+    uint64_t callback_stream_epoch;
     int64_t frame_position;
-    int64_t frame_timestamp;
     int64_t written_frames;
     int64_t queued_frames;
     bool timestamp_valid;
 
+    atomic_uint_fast64_t callback_count;
+    atomic_uint_fast64_t callback_total_ns;
+    atomic_uint_fast64_t callback_max_ns;
+    atomic_uint_fast64_t read_total_ns;
+    atomic_uint_fast64_t read_max_ns;
+    atomic_uint_fast64_t lock_contentions;
+    atomic_uint_fast64_t short_reads;
+    atomic_uint_fast64_t query_count;
+    atomic_uint_fast64_t query_total_ns;
+    atomic_uint_fast64_t query_max_ns;
+    atomic_uint_fast64_t query_failures;
+
     int encoding_type;
 };
 
-static void reset_timing(struct priv *p)
+static void atomic_update_max(atomic_uint_fast64_t *value, uint64_t sample)
+{
+    uint_fast64_t current = atomic_load_explicit(value, memory_order_relaxed);
+    while (current < sample &&
+           !atomic_compare_exchange_weak_explicit(value, &current, sample,
+                                                   memory_order_relaxed,
+                                                   memory_order_relaxed))
