From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: SweetVideo <sweetvideo@local>
Date: Thu, 3 Sep 2026 00:00:00 +0800
Subject: [PATCH] vo_gpu_next: add adaptive OHOS SDR to HDR output

Prefer a 10-bit EGL surface for opt-in SDR-to-HDR rendering, fall back to
the normal SDR surface when unavailable, and expose PQ/HLG target color
spaces to libplacebo so inverse tone mapping stays inside gpu-next.
Native PQ/HLG streams take precedence and bypass inverse tone mapping; the
source HDR state is cached only when the video format is reconfigured.
---
 options/options.c                 |  2 ++
 options/options.h                 |  1 +
 video/out/ohos_common.c           | 19 +++++++++++
 video/out/ohos_common.h           |  1 +
 video/out/opengl/context_ohos.c   | 38 +++++++++++++++++++++-
 video/out/vo_gpu_next.c            | 25 +++++++++++---
 6 files changed, 81 insertions(+), 5 deletions(-)

diff --git a/options/options.c b/options/options.c
index caa702e..858f7cd 100644
--- a/options/options.c
+++ b/options/options.c
@@ -247,6 +247,8 @@ static const m_option_t mp_vo_opt_list[] = {
 #endif
 #if HAVE_EGL_OHOS
     {"ohos-surface-size", OPT_SIZE_BOX(ohos_surface_size)},
+    {"ohos-sdr-to-hdr", OPT_CHOICE(ohos_sdr_to_hdr,
+        {"no", 0}, {"pq", 1}, {"hlg", 2})},
 #endif
 #if HAVE_D3D11
     {"d3d11-composition-size", OPT_SIZE_BOX(d3d11_composition_size)},
diff --git a/options/options.h b/options/options.h
index 58fe0eb..9ab7592 100644
--- a/options/options.h
+++ b/options/options.h
@@ -87,6 +87,7 @@ typedef struct mp_vo_opts {
     struct m_geometry android_surface_size;
 
     struct m_geometry ohos_surface_size;
+    int ohos_sdr_to_hdr;
 
     struct m_geometry d3d11_composition_size;
 
diff --git a/video/out/ohos_common.c b/video/out/ohos_common.c
index 6d769af..ebba662 100644
--- a/video/out/ohos_common.c
+++ b/video/out/ohos_common.c
@@ -30,6 +30,7 @@ struct vo_ohos_state {
     bool static_metadata_valid;
     bool hdr_brightness_valid;
     float hdr_brightness;
+    bool hdr_output_capable;
 };
 
 static bool is_hdr(const struct pl_color_space *color)
@@ -152,6 +153,7 @@ bool vo_ohos_init(struct vo *vo)
 
     *ctx = (struct vo_ohos_state){
         .log = mp_log_new(ctx, vo->log, "ohos"),
+        .hdr_output_capable = true,
     };
 
     if (vo->opts->WinID == 0 || vo->opts->WinID == -1) {
@@ -228,14 +230,31 @@ bool vo_ohos_set_surface_size(struct vo *vo, int w, int h)
     return true;
 }
 
+void vo_ohos_set_hdr_output_capable(struct vo *vo, bool capable)
+{
+    struct vo_ohos_state *ctx = vo->ohos;
+    if (ctx)
+        ctx->hdr_output_capable = capable;
+}
+
 struct pl_color_space vo_ohos_preferred_csp(struct vo *vo)
 {
+    struct vo_ohos_state *ctx = vo->ohos;
     const struct pl_color_space color = vo_get_current_params(vo).color;
 
+    // Native HDR always takes precedence. The SDR expansion mode must never
+    // remap PQ to HLG (or vice versa), nor replace the source HDR metadata.
     if (color.transfer == PL_COLOR_TRC_PQ)
         return pl_color_space_hdr10;
     if (color.transfer == PL_COLOR_TRC_HLG)
         return pl_color_space_bt2020_hlg;
+
+    if (ctx && ctx->hdr_output_capable && vo->opts->ohos_sdr_to_hdr) {
+        struct pl_color_space target = vo->opts->ohos_sdr_to_hdr == 2
+            ? pl_color_space_bt2020_hlg : pl_color_space_hdr10;
+        return target;
+    }
+
     return pl_color_space_srgb;
 }
 
diff --git a/video/out/ohos_common.h b/video/out/ohos_common.h
index 4791a4d..93f0495 100644
--- a/video/out/ohos_common.h
+++ b/video/out/ohos_common.h
@@ -31,6 +31,7 @@ void vo_ohos_uninit(struct vo *vo);
 OHNativeWindow *vo_ohos_native_window(struct vo *vo);
 bool vo_ohos_surface_size(struct vo *vo, int *w, int *h);
 bool vo_ohos_set_surface_size(struct vo *vo, int w, int h);
+void vo_ohos_set_hdr_output_capable(struct vo *vo, bool capable);
 struct pl_color_space vo_ohos_preferred_csp(struct vo *vo);
 bool vo_ohos_set_color(struct vo *vo, struct mp_image_params *params);
 void vo_ohos_invalidate_color(struct vo *vo);
diff --git a/video/out/opengl/context_ohos.c b/video/out/opengl/context_ohos.c
index 1eb5166..f4d3c49 100644
--- a/video/out/opengl/context_ohos.c
+++ b/video/out/opengl/context_ohos.c
@@ -30,6 +30,29 @@ struct priv {
     EGLSurface egl_surface;
 };
 
+struct hdr_config_selection {
+    EGLDisplay display;
+    bool ten_bit;
+};
+
+static int refine_hdr_config(void *user_data, EGLConfig *configs,
+                             int num_configs)
+{
+    struct hdr_config_selection *selection = user_data;
+    for (int n = 0; n < num_configs; n++) {
+        EGLint red = 0, green = 0, blue = 0, alpha = 0;
+        eglGetConfigAttrib(selection->display, configs[n], EGL_RED_SIZE, &red);
+        eglGetConfigAttrib(selection->display, configs[n], EGL_GREEN_SIZE, &green);
+        eglGetConfigAttrib(selection->display, configs[n], EGL_BLUE_SIZE, &blue);
+        eglGetConfigAttrib(selection->display, configs[n], EGL_ALPHA_SIZE, &alpha);
+        if (red == 10 && green == 10 && blue == 10 && alpha == 2) {
+            selection->ten_bit = true;
+            return n;
+        }
+    }
+    return 0;
+}
+
 static pl_color_space_t ohos_preferred_csp(struct ra_ctx *ctx)
 {
     return vo_ohos_preferred_csp(ctx->vo);
@@ -76,9 +99,22 @@ static bool ohos_init(struct ra_ctx *ctx)
     }
 
     EGLConfig config;
-    if (!mpegl_create_context(ctx, p->egl_display, &p->egl_context, &config))
+    bool hdr_requested = ctx->vo->opts->ohos_sdr_to_hdr != 0;
+    struct hdr_config_selection selection = {.display = p->egl_display};
+    struct mpegl_cb config_cb = {0};
+    if (hdr_requested) {
+        config_cb.refine_config = refine_hdr_config;
+        config_cb.user_data = &selection;
+    }
+    if (!mpegl_create_context_cb(ctx, p->egl_display, config_cb,
+                                 &p->egl_context, &config))
         goto fail;
 
+    vo_ohos_set_hdr_output_capable(ctx->vo,
+                                   !hdr_requested || selection.ten_bit);
+    if (hdr_requested && !selection.ten_bit)
+        MP_WARN(ctx, "No 10-bit EGLConfig; SDR-to-HDR disabled for this Surface\n");
+
     OHNativeWindow *native_window = vo_ohos_native_window(ctx->vo);
     EGLint native_visual_id = 0;
     if (!eglGetConfigAttrib(p->egl_display, config, EGL_NATIVE_VISUAL_ID,
diff --git a/video/out/vo_gpu_next.c b/video/out/vo_gpu_next.c
index 8e542c3..d578fdd 100644
--- a/video/out/vo_gpu_next.c
+++ b/video/out/vo_gpu_next.c
@@ -138,6 +138,7 @@ struct priv {
     // temporal mixing disabled until the interop can retain independently
     // addressable source images; this does not restrict the decoder queue.
     bool mutable_image_hwdec;
+    bool source_is_hdr;
 
     pl_options pars;
     struct m_config_cache *opts_cache;
@@ -1044,6 +1045,9 @@ static bool draw_frame(struct vo *vo, struct vo_frame *frame)
 
     struct pl_render_params params = pars->params;
     const struct gl_video_opts *opts = p->opts_cache->opts;
+    bool inverse_tone_mapping = opts->tone_map.inverse;
+    struct pl_color_map_params frame_color_map_params = pars->color_map_params;
+    params.color_map_params = &frame_color_map_params;
     bool will_redraw = frame->display_synced && frame->num_vsyncs > 1;
     bool cache_frame = will_redraw || frame->still;
     bool can_interpolate = !p->mutable_image_hwdec && opts->interpolation &&
@@ -1154,6 +1158,18 @@ static bool draw_frame(struct vo *vo, struct vo_frame *frame)
         target_csp = (struct pl_color_space){
             .transfer = opts->target_trc ? opts->target_trc : pl_color_space_hdr10.transfer };
     }
+
+    // OHOS SDR expansion follows the stream format cached by reconfig().
+    // Native PQ/HLG remains passthrough even if an older host also set
+    // --inverse-tone-mapping=yes.
+    // Conversely, enable expansion for SDR only when the negotiated output is
+    // actually HDR (the 10-bit EGL fallback can leave it as sRGB).
+    if (vo->opts->ohos_sdr_to_hdr) {
+        inverse_tone_mapping = !p->source_is_hdr &&
+            pl_color_transfer_is_hdr(target_csp.transfer);
+    }
+    frame_color_map_params.inverse_tone_mapping = inverse_tone_mapping;
+
     if (target_hint && frame->current) {
         const struct pl_color_space *source = &frame->current->params.color;
         const struct pl_color_space *target = &target_csp;
@@ -1209,7 +1225,7 @@ static bool draw_frame(struct vo *vo, struct vo_frame *frame)
         struct pl_color_space source_csp = *source;
         pl_color_space_infer_map(&source_csp, &hint);
         // Always prefer target luminance and transfer for inverse tone mapping
-        if (pl_color_transfer_is_hdr(target->transfer) && opts->tone_map.inverse) {
+        if (pl_color_transfer_is_hdr(target->transfer) && inverse_tone_mapping) {
             hint.transfer     = target->transfer;
             hint.hdr.max_luma = target->hdr.max_luma;
             hint.hdr.min_luma = target->hdr.min_luma;
@@ -1238,9 +1254,9 @@ static bool draw_frame(struct vo *vo, struct vo_frame *frame)
         if (!hint.hdr.max_cll)
             hint.hdr.max_cll = hint.hdr.max_luma;
         // If tone mapping is required, adjust maxCLL and maxFALL
-        if (source->hdr.max_luma > hint.hdr.max_luma || opts->tone_map.inverse) {
+        if (source->hdr.max_luma > hint.hdr.max_luma || inverse_tone_mapping) {
             // Set maxCLL to the target luminance if it's not already lower
-            if (!hint.hdr.max_cll || hint.hdr.max_luma < hint.hdr.max_cll || opts->tone_map.inverse)
+            if (!hint.hdr.max_cll || hint.hdr.max_luma < hint.hdr.max_cll || inverse_tone_mapping)
                 hint.hdr.max_cll = hint.hdr.max_luma;
             // There's no reliable way to estimate maxFALL here
             hint.hdr.max_fall = 0;
@@ -1343,7 +1359,7 @@ static bool draw_frame(struct vo *vo, struct vo_frame *frame)
                     (frame->current && opts->blend_subs) ? OSD_DRAW_OSD_ONLY : 0,
                     PL_OVERLAY_COORDS_DST_FRAME, &p->osd_state, &target, frame->current);
     apply_crop(&target, p->dst, swframe.fbo->params.w, swframe.fbo->params.h);
-    update_tm_viz(&pars->color_map_params, &target);
+    update_tm_viz(&frame_color_map_params, &target);
 
     struct pl_frame_mix mix = {0};
     if (frame->current) {
@@ -1542,6 +1558,7 @@ static int reconfig(struct vo *vo, struct mp_image_params *params)
     // External window resizes intentionally call reconfig(vo, NULL). Only a
     // real video reconfiguration carries image parameters.
     if (params) {
+        p->source_is_hdr = pl_color_transfer_is_hdr(params->color.transfer);
         bool mutable_image_hwdec = params->imgfmt == IMGFMT_OHCODEC;
         if (mutable_image_hwdec != p->mutable_image_hwdec) {
             p->mutable_image_hwdec = mutable_image_hwdec;
-- 
