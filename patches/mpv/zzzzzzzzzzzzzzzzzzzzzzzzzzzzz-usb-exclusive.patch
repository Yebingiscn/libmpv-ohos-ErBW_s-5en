diff --git a/audio/out/ao_usb_exclusive.c b/audio/out/ao_usb_exclusive.c
new file mode 100644
index 0000000000..a7439339a6
--- /dev/null
+++ b/audio/out/ao_usb_exclusive.c
@@ -0,0 +1,399 @@
+/* Authorized usbfs UAC output; no platform mixer. SPDX-License-Identifier: LGPL-2.1-or-later */
+#include "config.h"
+#include <errno.h>
+#include <fcntl.h>
+#include <limits.h>
+#include <linux/usbdevice_fs.h>
+#include <pthread.h>
+#include <stdatomic.h>
+#include <stdlib.h>
+#include <sys/ioctl.h>
+#include <unistd.h>
+#include "ao.h"
+#include "internal.h"
+#include "audio/format.h"
+#include "common/msg.h"
+#include "options/m_option.h"
+#include "osdep/timer.h"
+#include "usb_audio_protocol.h"
+
+#define SLOTS 8
+#define PACKETS 8
+struct slot { struct usbdevfs_urb *urb; uint8_t *data; unsigned frames; bool pending; };
+struct priv {
+    int source_fd, fd;
+    bool allow_dop, claimed, control_claimed, thread_live, mutex_live;
+    struct ua_mode mode;
+    struct slot slots[SLOTS], feedback;
+    pthread_t thread;
+    pthread_mutex_t mutex;
+    atomic_bool stop, failed;
+    bool started;
+    uint8_t *ring;
+    unsigned capacity, head, count, in_flight, stride, ticks, bus_rate;
+    uint64_t phase, rate_q32;
+    int64_t feedback_time, progress_time;
+    int volume_min, volume_max, volume_step;
+    bool volume_available;
+};
+static int transfer(struct priv *p, unsigned type, unsigned req, unsigned value,
+                    unsigned index, void *data, unsigned length)
+{
+    struct usbdevfs_ctrltransfer c = {.bRequestType = type, .bRequest = req,
+        .wValue = value, .wIndex = index, .wLength = length, .timeout = 500, .data = data};
+    return ioctl(p->fd, USBDEVFS_CONTROL, &c);
+}
+static bool claim(struct priv *p, unsigned iface)
+{
+    struct usbdevfs_disconnect_claim c = {.interface = iface};
+    if (ioctl(p->fd, USBDEVFS_DISCONNECT_CLAIM, &c) == 0) return true;
+    return ioctl(p->fd, USBDEVFS_CLAIMINTERFACE, &iface) == 0;
+}
+static void release_interface(struct priv *p, unsigned iface)
+{
+    ioctl(p->fd, USBDEVFS_RELEASEINTERFACE, &iface);
+    struct usbdevfs_ioctl c = {.ifno = (int)iface, .ioctl_code = USBDEVFS_CONNECT};
+    ioctl(p->fd, USBDEVFS_IOCTL, &c);
+}
+static bool set_alt(struct priv *p, unsigned alt)
+{
+    struct usbdevfs_setinterface s = {.interface = p->mode.interface, .altsetting = alt};
+    return ioctl(p->fd, USBDEVFS_SETINTERFACE, &s) == 0;
+}
+static bool rate_supported(struct priv *p, struct ua_mode *m, unsigned rate)
+{
+    if (!m->protocol) return ua_rate_supported(m, rate);
+    if (!m->clock) return false;
+    uint8_t ranges[2 + 12 * 32] = {0};
+    int n = transfer(p, 0xa1, 2, 0x100, (m->clock << 8) | m->control, ranges, sizeof(ranges));
+    if (n < 2) return false;
+    unsigned count = ua_le(ranges, 2);
+    if (!count || count > 32 || n < 2 + (int)count * 12) return false;
+    for (unsigned i = 0; i < count; i++) {
+        uint8_t *r = ranges + 2 + i * 12;
+        unsigned lo = ua_le(r, 4), hi = ua_le(r + 4, 4), step = ua_le(r + 8, 4);
+        if (rate >= lo && rate <= hi && (!step || (rate - lo) % step == 0)) return true;
+    }
+    return false;
+}
+static bool set_rate(struct priv *p, unsigned rate)
+{
+    struct ua_mode *m = &p->mode;
+    uint8_t b[4] = {rate, rate >> 8, rate >> 16, rate >> 24}, current[4] = {0};
+    if (m->protocol) {
+        unsigned index = (m->clock << 8) | m->control;
+        /* Read-only fixed clocks are valid if already at the exact rate. */
+        if (transfer(p, 0xa1, 1, 0x100, index, current, 4) == 4 && ua_le(current, 4) == rate) return true;
+        if (transfer(p, 0x21, 1, 0x100, index, b, 4) != 4) return false;
+        return transfer(p, 0xa1, 1, 0x100, index, current, 4) == 4 && ua_le(current, 4) == rate;
+    }
+    if (!m->frequency_control) return m->rate_count == 1 && m->rates[0] == rate;
+    if (transfer(p, 0x22, 1, 0x100, m->endpoint, b, 3) != 3) return false;
+    return transfer(p, 0xa2, 0x81, 0x100, m->endpoint, current, 3) == 3 && ua_le(current, 3) == rate;
+}
+static void volume_probe(struct priv *p)
+{
+    if (!p->mode.feature) return;
+    unsigned index = (p->mode.feature << 8) | p->mode.control;
+    uint8_t b[8] = {0};
+    if (p->mode.protocol) {
+        if (transfer(p, 0xa1, 2, 0x200, index, b, 8) != 8 || ua_le(b, 2) != 1) return;
+        p->volume_min = (int16_t)ua_le(b + 2, 2); p->volume_max = (int16_t)ua_le(b + 4, 2);
+        p->volume_step = ua_le(b + 6, 2);
+    } else {
+        if (transfer(p, 0xa1, 0x82, 0x200, index, b, 2) != 2) return;
+        p->volume_min = (int16_t)ua_le(b, 2);
+        if (transfer(p, 0xa1, 0x83, 0x200, index, b, 2) != 2) return;
+        p->volume_max = (int16_t)ua_le(b, 2);
+        if (transfer(p, 0xa1, 0x84, 0x200, index, b, 2) != 2) return;
+        p->volume_step = ua_le(b, 2);
+    }
+    /* 0x8000 means minus infinity, not an ordinary dB step. */
+    p->volume_available = p->volume_min > -32768 && p->volume_max > p->volume_min && p->volume_step > 0;
+}
+static int control(struct ao *ao, enum aocontrol cmd, void *arg)
+{
+    struct priv *p = ao->priv;
+    if (!p->volume_available || (cmd != AOCONTROL_SET_VOLUME && cmd != AOCONTROL_GET_VOLUME)) return CONTROL_UNKNOWN;
+    unsigned index = (p->mode.feature << 8) | p->mode.control;
+    uint8_t b[2];
+    if (cmd == AOCONTROL_GET_VOLUME) {
+        if (transfer(p, 0xa1, p->mode.protocol ? 1 : 0x81, 0x200, index, b, 2) != 2) return CONTROL_ERROR;
+        *(float *)arg = 100.0f * ((int16_t)ua_le(b, 2) - p->volume_min) / (p->volume_max - p->volume_min);
+    } else {
+        float v = *(float *)arg;
+        if (!(v >= 0 && v <= 100)) return CONTROL_ERROR;
+        int raw = p->volume_min + (int)((p->volume_max - p->volume_min) * v / 100);
+        raw = p->volume_min + (raw - p->volume_min) / p->volume_step * p->volume_step;
+        b[0] = raw; b[1] = raw >> 8;
+        if (transfer(p, 0x21, 1, 0x200, index, b, 2) != 2) return CONTROL_ERROR;
+    }
+    return CONTROL_OK;
+}
+static void fail(struct ao *ao)
+{
+    struct priv *p = ao->priv;
+    if (!atomic_exchange(&p->failed, true)) {
+        MP_ERR(ao, "USB exclusive transfer failed; stopping without mixer fallback.\n");
+        ao_report_error(ao);
+    }
+}
+static bool alloc_slot(struct slot *s, unsigned packets, unsigned bytes)
+{
+    s->urb = calloc(1, sizeof(*s->urb) + packets * sizeof(struct usbdevfs_iso_packet_desc));
+    s->data = malloc(bytes);
+    return s->urb && s->data;
+}
+static bool submit_feedback(struct priv *p)
+{
+    struct slot *s = &p->feedback;
+    memset(s->urb, 0, sizeof(*s->urb) + sizeof(struct usbdevfs_iso_packet_desc));
+    s->urb->type = USBDEVFS_URB_TYPE_ISO; s->urb->endpoint = p->mode.feedback;
+    s->urb->flags = USBDEVFS_URB_ISO_ASAP; s->urb->buffer = s->data;
+    s->urb->buffer_length = 4; s->urb->number_of_packets = 1;
+    s->urb->iso_frame_desc[0].length = p->bus_rate == 8000 ? 4 : 3;
+    s->urb->buffer_length = s->urb->iso_frame_desc[0].length;
+    s->urb->usercontext = s;
+    s->pending = ioctl(p->fd, USBDEVFS_SUBMITURB, s->urb) == 0;
+    return s->pending;
+}
+static void *worker(void *ctx)
+{
+    struct ao *ao = ctx;
+    struct priv *p = ao->priv;
+    while (!atomic_load(&p->stop) && !atomic_load(&p->failed)) {
+        pthread_mutex_lock(&p->mutex);
+        struct usbdevfs_urb *done = NULL;
+        while (ioctl(p->fd, USBDEVFS_REAPURBNDELAY, &done) == 0) {
+            struct slot *s = done->usercontext;
+            s->pending = false;
+            if (done->status || done->error_count) { fail(ao); break; }
+            for (int i = 0; i < done->number_of_packets; i++)
+                if (done->iso_frame_desc[i].status) fail(ao);
+            if (s == &p->feedback) {
+                unsigned n = done->iso_frame_desc[0].actual_length;
+                if (n == 3 || n == 4) {
+                    uint64_t q = (uint64_t)ua_le(s->data, n) << (n == 3 ? 18 : 16);
+                    uint64_t nominal = ((uint64_t)ao->samplerate << 32) / p->bus_rate;
+                    if (q < nominal * 99 / 100 || q > nominal * 101 / 100) { fail(ao); break; }
+                    p->rate_q32 = q; p->feedback_time = mp_time_ns();
+                } else { fail(ao); break; }
+            } else {
+                p->in_flight -= s->frames;
+                p->progress_time = mp_time_ns();
+            }
+        }
+        if (errno != EAGAIN && errno != EINTR && !atomic_load(&p->failed)) fail(ao);
+        if (p->started && !atomic_load(&p->failed)) {
+            if (p->mode.feedback && !p->feedback.pending && !submit_feedback(p)) fail(ao);
+            for (unsigned i = 0; i < SLOTS && !atomic_load(&p->failed); i++) {
+                struct slot *s = &p->slots[i];
+                if (s->pending || !p->count) continue;
+                unsigned total = 0, packets = 0;
+                uint64_t phase = p->phase;
+                memset(s->urb, 0, sizeof(*s->urb) + PACKETS * sizeof(struct usbdevfs_iso_packet_desc));
+                for (unsigned j = 0; j < PACKETS; j++) {
+                    uint64_t next_phase = phase;
+                    unsigned frames = ua_next_frames(&next_phase, p->rate_q32, p->ticks);
+                    if (frames * p->stride > p->mode.packet) { fail(ao); break; }
+                    if (total + frames > p->count) frames = p->count - total;
+                    if (!frames) break;
+                    phase = next_phase;
+                    s->urb->iso_frame_desc[j].length = frames * p->stride;
+                    total += frames; packets++;
+                }
+                if (!packets) break;
+                for (unsigned f = 0; f < total; f++)
+                    memcpy(s->data + f * p->stride, p->ring + ((p->head + f) % p->capacity) * p->stride, p->stride);
+                s->urb->type = USBDEVFS_URB_TYPE_ISO; s->urb->endpoint = p->mode.endpoint;
+                s->urb->flags = USBDEVFS_URB_ISO_ASAP; s->urb->buffer = s->data;
+                s->urb->buffer_length = total * p->stride; s->urb->number_of_packets = packets;
+                s->urb->usercontext = s;
+                if (ioctl(p->fd, USBDEVFS_SUBMITURB, s->urb) < 0) { fail(ao); break; }
+                s->pending = true; s->frames = total;
+                p->phase = phase; p->head = (p->head + total) % p->capacity;
+                p->count -= total; p->in_flight += total;
+            }
+            int64_t now = mp_time_ns();
+            if ((p->in_flight && now - p->progress_time > MP_TIME_S_TO_NS(2)) ||
+                (p->mode.feedback && now - p->feedback_time > MP_TIME_S_TO_NS(2))) fail(ao);
+        }
+        pthread_mutex_unlock(&p->mutex);
+        ao_wakeup(ao);
+        mp_sleep_ns(MP_TIME_MS_TO_NS(1));
+    }
+    return NULL;
+}
+static void stop_thread(struct priv *p)
+{
+    atomic_store(&p->stop, true);
+    if (p->thread_live) { pthread_join(p->thread, NULL); p->thread_live = false; }
+    for (unsigned i = 0; i <= SLOTS; i++) {
+        struct slot *s = i == SLOTS ? &p->feedback : &p->slots[i];
+        if (s->pending) ioctl(p->fd, USBDEVFS_DISCARDURB, s->urb);
+    }
+    /* Closing our duplicated fd alone does not cancel URBs while the ArkTS
+     * owner still holds the same file description. Reap every cancelled URB. */
+    unsigned pending = 0;
+    for (unsigned i = 0; i < SLOTS; i++) pending += p->slots[i].pending;
+    pending += p->feedback.pending;
+    while (pending) {
+        struct usbdevfs_urb *u = NULL;
+        if (ioctl(p->fd, USBDEVFS_REAPURB, &u) == 0) {
+            ((struct slot *)u->usercontext)->pending = false; pending--;
+        } else if (errno != EINTR) break;
+    }
+}
+static void reset(struct ao *ao)
+{
+    struct priv *p = ao->priv;
+    stop_thread(p);
+    p->started = false; p->count = p->head = p->in_flight = 0; p->phase = 0;
+}
+static void uninit(struct ao *ao)
+{
+    struct priv *p = ao->priv;
+    stop_thread(p);
+    if (p->claimed) { set_alt(p, 0); release_interface(p, p->mode.interface); }
+    if (p->control_claimed) release_interface(p, p->mode.control);
+    if (p->fd >= 0) close(p->fd);
+    for (unsigned i = 0; i <= SLOTS; i++) {
+        struct slot *s = i == SLOTS ? &p->feedback : &p->slots[i];
+        free(s->urb); free(s->data);
+    }
+    free(p->ring);
+    if (p->mutex_live) pthread_mutex_destroy(&p->mutex);
+}
+static int init(struct ao *ao)
+{
+    struct priv *p = ao->priv;
+    p->fd = -1;
+    atomic_init(&p->stop, false); atomic_init(&p->failed, false);
+    int fmt = af_fmt_from_planar(ao->format);
+    bool dop = fmt == AF_FORMAT_S_DOP;
+    if (ao->samplerate < 8000 || ao->samplerate > 1536000) return -1;
+    if (p->source_fd < 0 || (fmt != AF_FORMAT_S16 && fmt != AF_FORMAT_S32 && !dop) ||
+        (dop && !p->allow_dop) || ao->channels.num < 1 || ao->channels.num > 2) {
+        MP_ERR(ao, "USB bit-perfect requires integer PCM mono/stereo or explicitly enabled DoP.\n");
+        return -1;
+    }
+    p->fd = fcntl(p->source_fd, F_DUPFD_CLOEXEC, 0);
+    if (p->fd < 0) return -1;
+    uint8_t config[65535], head[9], active = 0;
+    if (transfer(p, 0x80, 8, 0, 0, &active, 1) != 1) goto error;
+    bool found = false;
+    for (unsigned i = 0; i < 16; i++) {
+        if (transfer(p, 0x80, 6, 0x200 | i, 0, head, 9) != 9) break;
+        if (head[5] != active) continue;
+        unsigned size = ua_le(head + 2, 2);
+        if (size < 9 || size > sizeof(config) || transfer(p, 0x80, 6, 0x200 | i, 0, config, size) != (int)size) goto error;
+        struct ua_caps caps;
+        if (!ua_parse(config, size, &caps)) goto error;
+        int best = -1;
+        for (unsigned j = 0; j < caps.count; j++) {
+            struct ua_mode *m = &caps.modes[j];
+            if (!m->pcm || !m->endpoint || m->channels != ao->channels.num || m->interval < 1 || m->interval > 4 ||
+                m->bytes < 2 || m->bytes > 4 ||
+                (m->bits != m->bytes * 8 && !(m->bytes == 4 && m->bits == 24)) ||
+                (fmt == AF_FORMAT_S32 && m->bits < 24) || (dop && m->bits < 24) ||
+                (((m->attributes >> 2) & 3) == 1 && !m->feedback) ||
+                !rate_supported(p, m, ao->samplerate)) continue;
+            if (best < 0 || (fmt == AF_FORMAT_S16 ? m->bits < caps.modes[best].bits : m->bits > caps.modes[best].bits)) best = j;
+        }
+        if (best < 0) goto error;
+        p->mode = caps.modes[best]; found = true; break;
+    }
+    if (!found) goto error;
+    int speed = ioctl(p->fd, USBDEVFS_GET_SPEED, NULL);
+    if (speed != 2 && speed != 3) goto error; /* Full/high speed only. */
+    p->bus_rate = speed == 3 ? 8000 : 1000;
+    p->ticks = 1u << (p->mode.interval - 1);
+    p->stride = p->mode.channels * p->mode.bytes;
+    p->rate_q32 = ((uint64_t)ao->samplerate << 32) / p->bus_rate;
+    unsigned extra = p->mode.feedback ? 1 : 0;
+    if (((ao->samplerate * p->ticks + p->bus_rate - 1) / p->bus_rate + extra) * p->stride > p->mode.packet) goto error;
+    if (!(p->control_claimed = claim(p, p->mode.control))) goto error;
+    if (!(p->claimed = claim(p, p->mode.interface))) goto error;
+    if (!set_alt(p, 0)) goto error;
+    if (p->mode.protocol && !set_rate(p, ao->samplerate)) goto error;
+    if (!set_alt(p, p->mode.alternate)) goto error;
+    if (!p->mode.protocol && !set_rate(p, ao->samplerate)) goto error;
+    volume_probe(p);
+    p->capacity = ao->samplerate / 4;
+    p->ring = malloc(p->capacity * p->stride);
+    if (!p->ring) goto error;
+    for (unsigned i = 0; i < SLOTS; i++) if (!alloc_slot(&p->slots[i], PACKETS, PACKETS * p->mode.packet)) goto error;
+    if (p->mode.feedback && !alloc_slot(&p->feedback, 1, 4)) goto error;
+    if (pthread_mutex_init(&p->mutex, NULL)) goto error;
+    p->mutex_live = true;
+    ao->format = fmt; ao->device_buffer = p->capacity;
+    MP_INFO(ao, "USB exclusive %d Hz / %u-bit / %s; hardware volume %s\n", ao->samplerate,
+        p->mode.bits, dop ? "DoP" : "PCM", p->volume_available ? "available" : "unavailable");
+    return 0;
+error:
+    MP_ERR(ao, "DAC does not support this exact format, or USB access failed.\n");
+    uninit(ao);
+    return -1;
+}
+static void start(struct ao *ao)
+{
+    struct priv *p = ao->priv;
+    pthread_mutex_lock(&p->mutex);
+    p->started = true; p->progress_time = p->feedback_time = mp_time_ns();
+    pthread_mutex_unlock(&p->mutex);
+    if (!p->thread_live) {
+        atomic_store(&p->stop, false);
+        if (pthread_create(&p->thread, NULL, worker, ao)) fail(ao);
+        else p->thread_live = true;
+    }
+}
+static bool write_data(struct ao *ao, void **data, int samples)
+{
+    struct priv *p = ao->priv;
+    pthread_mutex_lock(&p->mutex);
+    bool ok = !atomic_load(&p->failed) && samples >= 0 && (unsigned)samples <= p->capacity - p->count - p->in_flight;
+    unsigned src_bytes = af_fmt_to_bytes(ao->format), dst_bytes = p->mode.bytes;
+    for (int f = 0; ok && f < samples; f++) {
+        uint8_t *dst = p->ring + ((p->head + p->count + f) % p->capacity) * p->stride;
+        for (unsigned c = 0; c < p->mode.channels; c++) {
+            const uint8_t *src = (uint8_t *)data[0] + (f * p->mode.channels + c) * src_bytes;
+            uint32_t word = ua_le(src, src_bytes);
+            if (src_bytes == 2) word <<= 16;
+            if (ao->format != AF_FORMAT_S_DOP && p->mode.bits == 24 && (word & 255)) {
+                ok = false; break;
+            }
+            unsigned shift = 32 - dst_bytes * 8;
+            // 32-valid-bit DACs conventionally carry DoP in the low 24 bits;
+            // 24-valid-bit subslots retain the UAC-required left alignment.
+            if (ao->format == AF_FORMAT_S_DOP && p->mode.bits == 32) shift = 8;
+            if (shift && (word & ((1u << shift) - 1))) { ok = false; break; }
+            word >>= shift;
+            for (unsigned b = 0; b < dst_bytes; b++) dst[c * dst_bytes + b] = word >> (8 * b);
+        }
+    }
+    if (ok) p->count += samples;
+    pthread_mutex_unlock(&p->mutex);
+    if (!ok) fail(ao);
+    return ok;
+}
+static void get_state(struct ao *ao, struct mp_pcm_state *s)
+{
+    struct priv *p = ao->priv;
+    pthread_mutex_lock(&p->mutex);
+    s->queued_samples = p->count + p->in_flight;
+    s->free_samples = p->capacity - s->queued_samples;
+    s->delay = (double)s->queued_samples / ao->samplerate;
+    s->playing = p->started && s->queued_samples && !atomic_load(&p->failed);
+    pthread_mutex_unlock(&p->mutex);
+}
+#define OPT_BASE_STRUCT struct priv
+const struct ao_driver audio_out_usb_exclusive = {
+    .name = "usb-exclusive", .description = "Authorized USB Audio exclusive output",
+    .init = init, .uninit = uninit, .start = start, .reset = reset,
+    .write = write_data, .get_state = get_state, .control = control,
+    .priv_size = sizeof(struct priv), .priv_defaults = &(const struct priv){.source_fd = -1, .fd = -1},
+    .options = (const struct m_option[]){
+        {"fd", OPT_INT(source_fd), M_RANGE(-1, INT_MAX)},
+        {"dop", OPT_BOOL(allow_dop)}, {0}
+    }, .options_prefix = "usb-exclusive",
+};
diff --git a/audio/out/usb_audio_protocol.h b/audio/out/usb_audio_protocol.h
new file mode 100644
index 0000000000..4055d490db
--- /dev/null
+++ b/audio/out/usb_audio_protocol.h
@@ -0,0 +1,132 @@
+/* USB Audio Class wire helpers. SPDX-License-Identifier: LGPL-2.1-or-later */
+#ifndef MP_USB_AUDIO_PROTOCOL_H
+#define MP_USB_AUDIO_PROTOCOL_H
+#include <stdbool.h>
+#include <stdint.h>
+#include <stddef.h>
+#include <string.h>
+
+#define UA_MAX_MODES 64
+struct ua_mode {
+    uint8_t interface, alternate, protocol, control, terminal, clock;
+    uint8_t channels, bytes, bits, endpoint, feedback, interval, attributes;
+    uint8_t frequency_control, feature;
+    uint16_t packet;
+    uint32_t rates[32];
+    unsigned rate_count;
+    bool continuous, pcm;
+};
+struct ua_caps { struct ua_mode modes[UA_MAX_MODES]; unsigned count; };
+static inline uint32_t ua_le(const uint8_t *p, unsigned n)
+{
+    uint32_t v = 0;
+    for (unsigned i = 0; i < n; i++) v |= (uint32_t)p[i] << (8 * i);
+    return v;
+}
+/* Reject malformed descriptors, unsupported UAC versions and ambiguous layouts.
+ * Only a directly connected clock and master Feature Unit are used. */
+static inline bool ua_parse(const uint8_t *raw, size_t size, struct ua_caps *caps)
+{
+    memset(caps, 0, sizeof(*caps));
+    uint8_t clocks[256] = {0}, features[256] = {0};
+    uint8_t control = 0, protocol = 0, subclass = 0;
+    bool have_control = false;
+    struct ua_mode *m = NULL;
+    for (size_t pos = 0; pos < size;) {
+        const uint8_t *d = raw + pos;
+        if (size - pos < 2 || d[0] < 2 || d[0] > size - pos) return false;
+        unsigned n = d[0];
+        if (d[1] == 4) {
+            if (n < 9) return false;
+            m = NULL;
+            subclass = d[5] == 1 ? d[6] : 0;
+            protocol = d[7];
+            if (subclass == 1) {
+                if (have_control && control != d[2]) return false;
+                control = d[2]; have_control = true;
+            }
+            if (subclass == 2 && d[3] && (protocol == 0 || protocol == 0x20)) {
+                if (caps->count == UA_MAX_MODES) return false;
+                m = &caps->modes[caps->count++];
+                m->interface = d[2]; m->alternate = d[3];
+                m->protocol = protocol; m->control = control;
+            }
+        } else if (d[1] == 0x24 && n >= 3) {
+            if (subclass == 1 && d[2] == 2 && protocol == 0x20 && n >= 17)
+                clocks[d[3]] = d[7];
+            if (subclass == 1 && d[2] == 6) {
+                if (protocol == 0x20 && n >= 10 && ((ua_le(d + 5, 4) >> 2) & 3) == 3)
+                    features[d[4]] = d[3];
+                if (protocol == 0 && n >= 8 && d[5] && (d[6] & 2))
+                    features[d[4]] = d[3];
+            }
+            if (m && d[2] == 1) {
+                if (protocol == 0 && n >= 7) {
+                    m->terminal = d[3]; m->pcm = ua_le(d + 5, 2) == 1;
+                } else if (protocol == 0x20 && n >= 16) {
+                    m->terminal = d[3]; m->channels = d[10];
+                    m->pcm = d[5] == 1 && (ua_le(d + 6, 4) & 1);
+                }
+            }
+            if (m && d[2] == 2 && n >= 6 && d[3] == 1) {
+                if (protocol == 0x20) { m->bytes = d[4]; m->bits = d[5]; }
+                else {
+                    if (n < 8) return false;
+                    m->channels = d[4]; m->bytes = d[5]; m->bits = d[6];
+                    m->continuous = d[7] == 0;
+                    unsigned count = d[7] ? d[7] : 2;
+                    if (count > 32 || n < 8 + count * 3) return false;
+                    m->rate_count = count;
+                    for (unsigned i = 0; i < count; i++) m->rates[i] = ua_le(d + 8 + i * 3, 3);
+                }
+            }
+        } else if (m && d[1] == 5) {
+            if (n < 7) return false;
+            if ((d[3] & 3) == 1 && !(d[2] & 0x80) && !(d[3] & 0x30)) {
+                m->endpoint = d[2]; m->attributes = d[3]; m->interval = d[6];
+                uint16_t w = (uint16_t)ua_le(d + 4, 2);
+                m->packet = (w & 0x7ff) * (1 + ((w >> 11) & 3));
+                if (n >= 9) m->feedback = d[8];
+            } else if ((d[3] & 0x33) == 0x11 && (d[2] & 0x80)) m->feedback = d[2];
+        } else if (m && d[1] == 0x25 && n >= 4 && d[2] == 1) {
+            m->frequency_control = d[3] & 1;
+        }
+        pos += n;
+    }
+    for (unsigned i = 0; i < caps->count; i++) {
+        struct ua_mode *v = &caps->modes[i];
+        v->clock = clocks[v->terminal]; v->feature = features[v->terminal];
+    }
+    return true;
+}
+static inline bool ua_rate_supported(const struct ua_mode *m, uint32_t rate)
+{
+    if (m->continuous) return rate >= m->rates[0] && rate <= m->rates[1];
+    for (unsigned i = 0; i < m->rate_count; i++) if (rate == m->rates[i]) return true;
+    return false;
+}
+/* Fractional scheduling: never round 44.1 kHz to a fixed packet size. */
+static inline unsigned ua_next_frames(uint64_t *phase, uint64_t rate_q32, unsigned ticks)
+{
+    *phase += rate_q32 * ticks;
+    unsigned frames = (unsigned)(*phase >> 32);
+    *phase &= UINT32_MAX;
+    return frames;
+}
+static inline uint8_t ua_reverse(uint8_t v)
+{
+    v = (uint8_t)((v >> 4) | (v << 4));
+    v = (uint8_t)(((v & 0xcc) >> 2) | ((v & 0x33) << 2));
+    return (uint8_t)(((v & 0xaa) >> 1) | ((v & 0x55) << 1));
+}
+/* DoP 1.1: first DSD byte is the HIGH byte of the 16-bit payload. The
+ * canonical carrier is signed 32-bit, left-aligned 24-bit, little endian. */
+static inline void ua_dop(uint8_t out[4], uint8_t first, uint8_t second,
+                          bool lsb_first, uint8_t marker)
+{
+    out[0] = 0;
+    out[1] = lsb_first ? ua_reverse(second) : second;
+    out[2] = lsb_first ? ua_reverse(first) : first;
+    out[3] = marker;
+}
