diff --git a/audio/decode/ad_dop.c b/audio/decode/ad_dop.c
new file mode 100644
index 0000000000..95fec25028
--- /dev/null
+++ b/audio/decode/ad_dop.c
@@ -0,0 +1,92 @@
+/* Lossless DSD packet -> DoP carrier. SPDX-License-Identifier: LGPL-2.1-or-later */
+#include <limits.h>
+#include "audio/aframe.h"
+#include "audio/format.h"
+#include "audio/out/usb_audio_protocol.h"
+#include "common/msg.h"
+#include "demux/packet.h"
+#include "demux/stheader.h"
+#include "filters/f_decoder_wrapper.h"
+#include "filters/filter_internal.h"
+
+struct dop {
+    struct mp_decoder public;
+    struct mp_codec_params *codec;
+    struct mp_aframe_pool *pool;
+    bool planar, lsb, pending;
+    uint8_t marker, carry[2];
+    double carry_pts;
+};
+static void reset(struct mp_filter *f)
+{
+    struct dop *p = f->priv;
+    p->pending = false; p->marker = 0x05;
+}
+static void process(struct mp_filter *f)
+{
+    struct dop *p = f->priv;
+    if (!mp_pin_can_transfer_data(f->ppins[1], f->ppins[0])) return;
+    struct mp_frame input = mp_pin_out_read(f->ppins[0]);
+    if (input.type == MP_FRAME_EOF) {
+        if (p->pending) { /* Never silently discard the final DSD byte. */
+            MP_ERR(f, "Odd DSD byte count cannot form an exact DoP frame.\n");
+            mp_filter_internal_mark_failed(f); return;
+        }
+        mp_pin_in_write(f->ppins[1], input); return;
+    }
+    if (input.type != MP_FRAME_PACKET) {
+        if (input.type) { mp_frame_unref(&input); mp_filter_internal_mark_failed(f); }
+        return;
+    }
+    struct demux_packet *pkt = input.data;
+    int channels = p->codec->channels.num;
+    if (pkt->len > INT_MAX || pkt->len % channels) goto error;
+    int bytes = pkt->len / channels, carry = p->pending ? 1 : 0;
+    int frames = (bytes + carry) / 2;
+    struct mp_aframe *out = mp_aframe_create();
+    mp_aframe_set_format(out, AF_FORMAT_S_DOP);
+    mp_aframe_set_rate(out, p->codec->samplerate / 2);
+    mp_aframe_set_chmap(out, &p->codec->channels);
+    mp_aframe_set_pts(out, carry ? p->carry_pts : pkt->pts);
+    if (frames && mp_aframe_pool_allocate(p->pool, out, frames) < 0) { talloc_free(out); goto error; }
+    uint8_t *dst = frames ? mp_aframe_get_data_rw(out)[0] : NULL;
+    for (int s = 0; s < frames; s++) {
+        for (int c = 0; c < channels; c++) {
+            int a = 2 * s - carry, b = a + 1;
+            uint8_t first = a < 0 ? p->carry[c] : pkt->buffer[p->planar ? c * bytes + a : a * channels + c];
+            uint8_t second = pkt->buffer[p->planar ? c * bytes + b : b * channels + c];
+            ua_dop(dst + (s * channels + c) * 4, first, second, p->lsb, p->marker);
+        }
+        p->marker ^= 0xff;
+    }
+    p->pending = (bytes + carry) % 2;
+    if (p->pending && bytes) {
+        for (int c = 0; c < channels; c++)
+            p->carry[c] = pkt->buffer[p->planar ? (c + 1) * bytes - 1 : (bytes - 1) * channels + c];
+        p->carry_pts = pkt->pts == MP_NOPTS_VALUE ? MP_NOPTS_VALUE : pkt->pts + (double)(bytes - 1) / p->codec->samplerate;
+    }
+    talloc_free(pkt);
+    if (frames) mp_pin_in_write(f->ppins[1], MAKE_FRAME(MP_FRAME_AUDIO, out));
+    else { talloc_free(out); mp_filter_internal_mark_progress(f); }
+    return;
+error:
+    talloc_free(pkt); mp_filter_internal_mark_failed(f);
+}
+static const struct mp_filter_info info = {
+    .name = "ad_dop", .priv_size = sizeof(struct dop), .process = process, .reset = reset,
+};
+static struct mp_decoder *create(struct mp_filter *parent, struct mp_codec_params *codec, const char *decoder)
+{
+    if (!codec->codec || strncmp(codec->codec, "dsd_", 4) || codec->channels.num < 1 ||
+        codec->channels.num > 2 || codec->samplerate <= 0 || codec->samplerate % 2) return NULL;
+    struct mp_filter *f = mp_filter_create(parent, &info);
+    if (!f) return NULL;
+    mp_filter_add_pin(f, MP_PIN_IN, "in"); mp_filter_add_pin(f, MP_PIN_OUT, "out");
+    struct dop *p = f->priv;
+    p->public.f = f; p->codec = codec; p->pool = mp_aframe_pool_create(p);
+    p->planar = strstr(codec->codec, "planar") != NULL;
+    p->lsb = strstr(codec->codec, "lsbf") != NULL;
+    reset(f);
+    return &p->public;
+}
+const struct mp_decoder_fns ad_dop = {.create = create};
