 };
 
 int mp_decoder_wrapper_control(struct mp_decoder_wrapper *d,
diff --git a/player/audio.c b/player/audio.c
index b3e975dd2e..9f90460d0e 100644
--- a/player/audio.c
+++ b/player/audio.c
@@ -199,6 +199,13 @@ void update_playback_speed(struct MPContext *mpctx)
     mpctx->audio_speed = mpctx->opts->playback_speed * mpctx->speed_factor_a;
     mpctx->video_speed = mpctx->opts->playback_speed * mpctx->speed_factor_v;
 
+    if (mpctx->vo_chain && mpctx->vo_chain->track &&
+        mpctx->vo_chain->track->dec) {
+        mp_decoder_wrapper_control(mpctx->vo_chain->track->dec,
+                                   VDCTRL_SET_PLAYBACK_SPEED,
