diff --git a/filters/f_decoder_wrapper.c b/filters/f_decoder_wrapper.c
index 5e2e8d74c0..e2a7485821 100644
--- a/filters/f_decoder_wrapper.c
+++ b/filters/f_decoder_wrapper.c
@@ -212,6 +212,8 @@ struct priv {
     int coverart_returned; // 0: no, 1: coverart frame itself, 2: EOF returned
 
     int play_dir;
+    double playback_speed;
+    bool playback_speed_set;
 
     // --- The following fields can be accessed only from the mp_decoder_wrapper
     //     user thread.
@@ -350,6 +352,10 @@ int mp_decoder_wrapper_control(struct mp_decoder_wrapper *d,
     struct priv *p = d->f->priv;
     int res = CONTROL_UNKNOWN;
     thread_lock(p);
+    if (cmd == VDCTRL_SET_PLAYBACK_SPEED) {
+        p->playback_speed = *(double *)arg;
+        p->playback_speed_set = true;
+    }
     if (cmd == VDCTRL_GET_HWDEC) {
         res = update_cached_values(p);
         mp_mutex_lock(&p->cache_lock);
@@ -455,6 +461,10 @@ static bool reinit_decoder(struct priv *p)
 
         p->decoder = driver->create(p->decf, p->codec, sel->decoder);
         if (p->decoder) {
+            if (p->playback_speed_set && p->decoder->control)
+                p->decoder->control(p->decoder->f,
+                                    VDCTRL_SET_PLAYBACK_SPEED,
+                                    &p->playback_speed);
             p->codec->decoder = talloc_strdup(p, sel->decoder);
             p->codec->decoder_desc = talloc_strdup(p, sel->desc && sel->desc[0] ? sel->desc : NULL);
             MP_VERBOSE(p, "Selected decoder: %s", sel->decoder);
diff --git a/filters/f_decoder_wrapper.h b/filters/f_decoder_wrapper.h
