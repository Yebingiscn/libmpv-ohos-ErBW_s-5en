diff --git a/video/decode/vd_lavc.c b/video/decode/vd_lavc.c
index 224d522e6b..0901923078 100644
--- a/video/decode/vd_lavc.c
+++ b/video/decode/vd_lavc.c
@@ -845,6 +845,11 @@ static void init_avctx(struct mp_filter *vd)
         goto error;
     }
 
+    if (lavc_codec->wrapper_name &&
+        strcmp(lavc_codec->wrapper_name, "ohcodec") == 0 &&
+        c->fps > 0 && isfinite(c->fps))
+        avctx->framerate = av_d2q(c->fps, 1000000);
+
 #ifdef FUZZING_BUILD_MODE_UNSAFE_FOR_PRODUCTION
     if (avctx->width > 8192 || avctx->height > 8192) {
         MP_ERR(vd, "Frame size too big %" PRIu32 "x%" PRIu32 ".\n", avctx->width, avctx->height);
@@ -1392,6 +1397,13 @@ static int control(struct mp_filter *vd, enum dec_ctrl cmd, void *arg)
     case VDCTRL_REINIT:
         reinit(vd);
         return CONTROL_TRUE;
+    case VDCTRL_SET_PLAYBACK_SPEED: {
+        AVCodecContext *avctx = ctx->avctx;
+        if (!avctx)
+            break;
+        int ret = avcodec_ohcodec_set_playback_speed(avctx, *(double *)arg);
+        return ret >= 0 ? CONTROL_TRUE : CONTROL_FALSE;
+    }
     }
     return CONTROL_UNKNOWN;
 }
