diff --git a/audio/out/ohaudio_suite_loader.h b/audio/out/ohaudio_suite_loader.h
new file mode 100644
--- /dev/null
+++ b/audio/out/ohaudio_suite_loader.h
@@ -0,0 +1,97 @@
+/* AudioSuite is optional: keep all SDK references behind runtime lookup. */
+#ifndef MP_OHAUDIO_SUITE_LOADER_H
+#define MP_OHAUDIO_SUITE_LOADER_H
+#include <stdbool.h>
+#include <dlfcn.h>
+#include <pthread.h>
+#include <ohaudiosuite/native_audio_suite_base.h>
+#include <ohaudiosuite/native_audio_suite_engine.h>
+
+struct ohaudio_suite_api {
+    __typeof__(&OH_AudioSuiteEngine_ConnectNodes) OH_AudioSuiteEngine_ConnectNodes;
+    __typeof__(&OH_AudioSuiteEngine_Create) OH_AudioSuiteEngine_Create;
+    __typeof__(&OH_AudioSuiteEngine_CreateNode) OH_AudioSuiteEngine_CreateNode;
+    __typeof__(&OH_AudioSuiteEngine_CreatePipeline) OH_AudioSuiteEngine_CreatePipeline;
+    __typeof__(&OH_AudioSuiteEngine_Destroy) OH_AudioSuiteEngine_Destroy;
+    __typeof__(&OH_AudioSuiteEngine_DestroyNode) OH_AudioSuiteEngine_DestroyNode;
+    __typeof__(&OH_AudioSuiteEngine_DestroyPipeline) OH_AudioSuiteEngine_DestroyPipeline;
+    __typeof__(&OH_AudioSuiteEngine_IsNodeTypeSupported) OH_AudioSuiteEngine_IsNodeTypeSupported;
+    __typeof__(&OH_AudioSuiteEngine_MultiRenderFrame) OH_AudioSuiteEngine_MultiRenderFrame;
+    __typeof__(&OH_AudioSuiteEngine_RenderFrame) OH_AudioSuiteEngine_RenderFrame;
+    __typeof__(&OH_AudioSuiteEngine_SetEnvironmentType) OH_AudioSuiteEngine_SetEnvironmentType;
+    __typeof__(&OH_AudioSuiteEngine_SetEqualizerFrequencyBandGains) OH_AudioSuiteEngine_SetEqualizerFrequencyBandGains;
+    __typeof__(&OH_AudioSuiteEngine_SetGeneralVoiceChangeType) OH_AudioSuiteEngine_SetGeneralVoiceChangeType;
+    __typeof__(&OH_AudioSuiteEngine_SetPureVoiceChangeOption) OH_AudioSuiteEngine_SetPureVoiceChangeOption;
+    __typeof__(&OH_AudioSuiteEngine_SetSoundFieldType) OH_AudioSuiteEngine_SetSoundFieldType;
+    __typeof__(&OH_AudioSuiteEngine_SetSpaceRenderExtensionParams) OH_AudioSuiteEngine_SetSpaceRenderExtensionParams;
+    __typeof__(&OH_AudioSuiteEngine_SetSpaceRenderPositionParams) OH_AudioSuiteEngine_SetSpaceRenderPositionParams;
+    __typeof__(&OH_AudioSuiteEngine_SetSpaceRenderRotationParams) OH_AudioSuiteEngine_SetSpaceRenderRotationParams;
+    __typeof__(&OH_AudioSuiteEngine_SetTempoAndPitch) OH_AudioSuiteEngine_SetTempoAndPitch;
+    __typeof__(&OH_AudioSuiteEngine_SetVoiceBeautifierType) OH_AudioSuiteEngine_SetVoiceBeautifierType;
+    __typeof__(&OH_AudioSuiteEngine_StartPipeline) OH_AudioSuiteEngine_StartPipeline;
+    __typeof__(&OH_AudioSuiteEngine_StopPipeline) OH_AudioSuiteEngine_StopPipeline;
+    __typeof__(&OH_AudioSuiteNodeBuilder_Create) OH_AudioSuiteNodeBuilder_Create;
+    __typeof__(&OH_AudioSuiteNodeBuilder_Destroy) OH_AudioSuiteNodeBuilder_Destroy;
+    __typeof__(&OH_AudioSuiteNodeBuilder_Reset) OH_AudioSuiteNodeBuilder_Reset;
+    __typeof__(&OH_AudioSuiteNodeBuilder_SetFormat) OH_AudioSuiteNodeBuilder_SetFormat;
+    __typeof__(&OH_AudioSuiteNodeBuilder_SetNodeType) OH_AudioSuiteNodeBuilder_SetNodeType;
+    __typeof__(&OH_AudioSuiteNodeBuilder_SetRequestDataCallback) OH_AudioSuiteNodeBuilder_SetRequestDataCallback;
+};
+static struct ohaudio_suite_api suite_api;
+static pthread_once_t suite_load_once = PTHREAD_ONCE_INIT;
+static bool suite_available;
+
+static void load_audio_suite_once(void)
+{
+    void *library = dlopen("libohaudiosuite.so", RTLD_NOW | RTLD_LOCAL);
+    if (!library)
+        return;
+    struct ohaudio_suite_api api = {0};
+#define LOAD_SUITE_SYMBOL(name) do { \
+    api.name = (__typeof__(api.name))dlsym(library, #name); \
+    if (!api.name) goto unavailable; \
+} while (0)
+    LOAD_SUITE_SYMBOL(OH_AudioSuiteEngine_ConnectNodes);
+    LOAD_SUITE_SYMBOL(OH_AudioSuiteEngine_Create);
+    LOAD_SUITE_SYMBOL(OH_AudioSuiteEngine_CreateNode);
+    LOAD_SUITE_SYMBOL(OH_AudioSuiteEngine_CreatePipeline);
+    LOAD_SUITE_SYMBOL(OH_AudioSuiteEngine_Destroy);
+    LOAD_SUITE_SYMBOL(OH_AudioSuiteEngine_DestroyNode);
+    LOAD_SUITE_SYMBOL(OH_AudioSuiteEngine_DestroyPipeline);
+    LOAD_SUITE_SYMBOL(OH_AudioSuiteEngine_IsNodeTypeSupported);
+    LOAD_SUITE_SYMBOL(OH_AudioSuiteEngine_MultiRenderFrame);
+    LOAD_SUITE_SYMBOL(OH_AudioSuiteEngine_RenderFrame);
+    LOAD_SUITE_SYMBOL(OH_AudioSuiteEngine_SetEnvironmentType);
+    LOAD_SUITE_SYMBOL(OH_AudioSuiteEngine_SetEqualizerFrequencyBandGains);
+    LOAD_SUITE_SYMBOL(OH_AudioSuiteEngine_SetGeneralVoiceChangeType);
+    LOAD_SUITE_SYMBOL(OH_AudioSuiteEngine_SetPureVoiceChangeOption);
+    LOAD_SUITE_SYMBOL(OH_AudioSuiteEngine_SetSoundFieldType);
+    LOAD_SUITE_SYMBOL(OH_AudioSuiteEngine_SetSpaceRenderExtensionParams);
+    LOAD_SUITE_SYMBOL(OH_AudioSuiteEngine_SetSpaceRenderPositionParams);
+    LOAD_SUITE_SYMBOL(OH_AudioSuiteEngine_SetSpaceRenderRotationParams);
+    LOAD_SUITE_SYMBOL(OH_AudioSuiteEngine_SetTempoAndPitch);
+    LOAD_SUITE_SYMBOL(OH_AudioSuiteEngine_SetVoiceBeautifierType);
+    LOAD_SUITE_SYMBOL(OH_AudioSuiteEngine_StartPipeline);
+    LOAD_SUITE_SYMBOL(OH_AudioSuiteEngine_StopPipeline);
+    LOAD_SUITE_SYMBOL(OH_AudioSuiteNodeBuilder_Create);
+    LOAD_SUITE_SYMBOL(OH_AudioSuiteNodeBuilder_Destroy);
+    LOAD_SUITE_SYMBOL(OH_AudioSuiteNodeBuilder_Reset);
+    LOAD_SUITE_SYMBOL(OH_AudioSuiteNodeBuilder_SetFormat);
+    LOAD_SUITE_SYMBOL(OH_AudioSuiteNodeBuilder_SetNodeType);
+    LOAD_SUITE_SYMBOL(OH_AudioSuiteNodeBuilder_SetRequestDataCallback);
+#undef LOAD_SUITE_SYMBOL
+    // Publish only a complete table. Keep the library loaded for callbacks
+    // and subsequent AO instances; never unload while audio threads use it.
+    suite_api = api;
+    suite_available = true;
+    return;
+unavailable:
+    dlclose(library);
+}
+
+static bool audio_suite_available(void)
+{
+    pthread_once(&suite_load_once, load_audio_suite_once);
+    return suite_available;
+}
+#endif
