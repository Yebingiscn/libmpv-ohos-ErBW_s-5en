diff --git a/audio/out/usb_audio_dsd.h b/audio/out/usb_audio_dsd.h
new file mode 100644
index 0000000000..61de4bb51b
--- /dev/null
+++ b/audio/out/usb_audio_dsd.h
@@ -0,0 +1,48 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later
+ * Device facts from Linux sound/usb/quirks.c,
+ * snd_usb_interface_dsd_format_quirks (consulted 2026-09-25).
+ * https://github.com/torvalds/linux/blob/master/sound/usb/quirks.c
+ * Only known U32 transports are enabled; no chipset/vendor wildcard.
+ */
+#ifndef MP_USB_AUDIO_DSD_H
+#define MP_USB_AUDIO_DSD_H
+#include "usb_audio_protocol.h"
+enum ua_dsd_order { UA_DSD_NONE, UA_DSD_U32_BE, UA_DSD_U32_LE };
+static inline unsigned ua_dsd_alt(uint16_t vendor, uint16_t product)
+{
+    uint32_t id = ((uint32_t)vendor << 16) | product;
+    static const uint32_t alt2[] = {
+        0x139f5504, 0x20b13089, 0x25220007, 0x25220009,
+        0x25220012, 0x27720230, 0x16d0071a, 0x16d00a23,
+    };
+    static const uint32_t alt3[] = {
+        0x0d8c0316, 0x10cb0103, 0x16d006b2, 0x16d006b4,
+        0x16d00733, 0x16d009d8, 0x16d009db, 0x16d009dd,
+        0x16d00ab1, 0x16d0eca1, 0x1db50003, 0x20a04143,
+        0x22e1ca01, 0x249c9326, 0x26160106, 0x26220041,
+        0x26220061, 0x278b5100, 0x27f73002, 0x29a20086,
+        0x6b420042,
+    };
+    for (unsigned i = 0; i < sizeof(alt2) / sizeof(alt2[0]); i++)
+        if (id == alt2[i]) return 2;
+    for (unsigned i = 0; i < sizeof(alt3) / sizeof(alt3[0]); i++)
+        if (id == alt3[i]) return 3;
+    return 0;
+}
+static inline enum ua_dsd_order ua_dsd_mode(uint16_t vendor, uint16_t product,
+                                          uint16_t revision, const struct ua_mode *m)
+{
+    unsigned alt = ua_dsd_alt(vendor, product);
+    if (!alt || m->alternate != alt || m->protocol != 0x20 ||
+        m->bytes != 4 || m->bits != 32) return UA_DSD_NONE;
+    if (vendor == 0x16d0 && product == 0x071a) {
+        if (revision == 0x0199) return UA_DSD_U32_LE;
+        if (revision != 0x019b && revision != 0x0203) return UA_DSD_NONE;
+    }
+    return UA_DSD_U32_BE;
+}
+static inline void ua_dsd_wire(uint8_t dst[4], const uint8_t src[4], enum ua_dsd_order order)
+{
+    for (unsigned i = 0; i < 4; i++) dst[i] = src[order == UA_DSD_U32_LE ? 3 - i : i];
+}
+#endif
