diff --git a/audio/decode/dsd_packer.h b/audio/decode/dsd_packer.h
new file mode 100644
index 0000000000..aa1ac7212f
--- /dev/null
+++ b/audio/decode/dsd_packer.h
@@ -0,0 +1,31 @@
+/* Lossless DSD framing. SPDX-License-Identifier: LGPL-2.1-or-later */
+#ifndef MP_DSD_PACKER_H
+#define MP_DSD_PACKER_H
+#include "audio/out/usb_audio_protocol.h"
+struct dsd_packer { uint8_t carry[2][4], marker; unsigned count; };
+static inline void dsd_packer_reset(struct dsd_packer *p)
+{
+    memset(p, 0, sizeof(*p)); p->marker = 0x05;
+}
+/* Native carrier: four chronological MSB-first bytes per channel. */
+static inline unsigned dsd_pack(struct dsd_packer *p, uint8_t *out,
+    const uint8_t *const data[2], unsigned bytes, unsigned channels,
+    bool planar, bool lsb, bool native)
+{
+    unsigned frames = 0, group = native ? 4 : 2;
+    for (unsigned i = 0; i < bytes; i++) {
+        for (unsigned c = 0; c < channels; c++) {
+            uint8_t v = planar ? data[c][i] : data[0][i * channels + c];
+            p->carry[c][p->count] = lsb ? ua_reverse(v) : v;
+        }
+        if (++p->count != group) continue;
+        for (unsigned c = 0; c < channels; c++) {
+            uint8_t *dst = out + (frames * channels + c) * 4;
+            if (native) memcpy(dst, p->carry[c], 4);
+            else ua_dop(dst, p->carry[c][0], p->carry[c][1], false, p->marker);
+        }
+        p->count = 0; p->marker ^= 0xff; frames++;
+    }
+    return frames;
+}
+#endif
