+static bool frame_uses_current_device(struct vo *vo, struct mp_image *image)
+{
+    struct priv *p = vo->priv;
+    if (!image->hwctx || !p->hwctx.av_device_ref)
+        return false;
+    AVHWFramesContext *frames = (void *)image->hwctx->data;
+    if (!frames->device_ref ||
+        frames->device_ref->data != p->hwctx.av_device_ref->data)
+        return false;
+    AVHWDeviceContext *device = (void *)frames->device_ref->data;
+    struct ohcodec_output *output = device->user_opaque;
+    return output && !output->retired;
+}
