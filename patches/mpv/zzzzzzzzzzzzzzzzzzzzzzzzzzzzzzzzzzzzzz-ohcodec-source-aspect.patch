+static int prepare_decoder(struct vo *vo, struct voctrl_prepare_decoder *request)
+{
+    struct priv *p = vo->priv;
+    AVBufferRef *ref = p->hwctx.av_device_ref;
+    if (!ref || !request->device_ref || request->device_ref->data != ref->data)
+        return VO_ERROR;
+    const struct mp_image_params *source = request->params;
+    if (!source || source->w <= 0 || source->h <= 0)
+        return VO_ERROR;
+    AVHWDeviceContext *device = (void *)ref->data;
+    struct ohcodec_output *output = device->user_opaque;
+    if (output->retired)
+        return VO_ERROR;
+    if (output->prepared && mp_image_params_equal(&output->source, source))
+        return VO_TRUE;
+    bool want_vpe = vo->opts->ohos_super_resolution && !vo->opts->ohos_sdr_to_hdr;
+    if (!output->vpe && !want_vpe) {
+        output->source = *source;
+        output->prepared = true;
+        return VO_TRUE;
+    }
+
+    if (output->prepared) {
+        // Frames can keep the old decoder/device/input Surface alive. Stop
+        // its output producer, but let its last owner destroy the input.
+        AVBufferRef *next = create_ohcodec_device_ref(vo);
+        AVBufferRef *decoder_ref = next ? av_buffer_ref(next) : NULL;
+        if (!decoder_ref) {
+            av_buffer_unref(&next);
+            return VO_ERROR;
+        }
+        output->retired = true;
+        if (!ohos_vpe_stop(output->vpe)) {
+            ohos_vpe_check(output->vpe, vo);
+            av_buffer_unref(&decoder_ref);
+            av_buffer_unref(&next);
+            return VO_ERROR;
+        }
+        av_buffer_unref(&p->hwctx.av_device_ref);
+        p->hwctx.av_device_ref = next;
+        request->replacement = decoder_ref;
+        device = (void *)next->data;
+        output = device->user_opaque;
+    }
+
+    output->source = *source;
+    output->prepared = true;
+    if (want_vpe) {
+        int source_w = 0, source_h = 0;
+        mp_image_params_get_dsize(source, &source_w, &source_h);
+        int width = vo->opts->ohos_surface_size.w;
+        int height = vo->opts->ohos_surface_size.h;
+        if (width <= 0 || height <= 0) {
+            width = source_w;
+            height = source_h;
+        }
+        double scale = MPMIN((double)width / source_w,
+                            (double)height / source_h);
+        width = MPMAX(2, (int)(source_w * scale)) & ~1;
+        height = MPMAX(2, (int)(source_h * scale)) & ~1;
+        MP_WARN(vo, "[SuperResolution] source=%dx%d sar=%d:%d output=%dx%d before decoder open\n",
+                source->w, source->h, source->p_w, source->p_h, width, height);
+        output->vpe = ohos_vpe_create(vo->log, output->window, width, height);
+        ohos_vpe_attach(output->vpe, vo);
+        AVOHCodecDeviceContext *hwctx = device->hwctx;
+        hwctx->native_window = output->vpe ? ohos_vpe_input(output->vpe)
+                                         : output->window;
+    }
+    return VO_TRUE;
+}
