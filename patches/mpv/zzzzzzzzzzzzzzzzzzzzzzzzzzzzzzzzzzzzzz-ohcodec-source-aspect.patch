+bool ohos_vpe_stop(struct ohos_vpe *vpe)
+{
+    if (!vpe)
+        return true;
+    ohos_vpe_set_wakeup(vpe, NULL, NULL);
+    ohos_vpe_stop_output(vpe);
+    if (vpe->running) {
+        int ret = OH_VideoProcessing_Stop(vpe->processor);
+        if (ret) {
+            atomic_store(&vpe->error, ret);
+            mp_warn(vpe->log, "[SuperResolution] Stop failed: %d\n", ret);
+            return false;
+        }
+        vpe->running = false;
+    }
+    return true;
+}
