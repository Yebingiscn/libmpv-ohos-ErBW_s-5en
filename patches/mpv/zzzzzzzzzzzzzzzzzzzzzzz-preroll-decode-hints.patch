+// Called only on the decoder thread. The hint is distinct from playback
+// speed, which may enable adaptive dropping on the platform decoder.
+static void update_decode_hints(struct priv *p)
+{
+    if (p->codec->type != STREAM_VIDEO || !p->decoder || !p->decoder->control)
+        return;
+    int hints[2] = {
+        p->play_dir > 0 && (p->codec_pts == MP_NOPTS_VALUE ||
+                           p->start_pts != MP_NOPTS_VALUE),
+        p->play_dir > 0 && p->opts->correct_pts && p->opts->repair_dts_pts &&
+            mp_dts_pts_no_drop(&p->dts_pts_repair),
+    };
+    p->decoder->control(p->decoder->f, VDCTRL_SET_DECODE_HINTS, hints);
+}
