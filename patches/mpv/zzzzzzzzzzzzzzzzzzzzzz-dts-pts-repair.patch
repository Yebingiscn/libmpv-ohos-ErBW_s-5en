diff --git a/filters/dts_pts_repair.h b/filters/dts_pts_repair.h
new file mode 100644
--- /dev/null
+++ b/filters/dts_pts_repair.h
@@ -0,0 +1,80 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+#include <stdbool.h>
+#include <stdint.h>
+#include <math.h>
+
+// Narrow fallback for CFR packets incorrectly muxed with PTS == DTS.
+// Packet evidence alone is not sufficient: normal low-delay video has that
+// property too. Require repeated decoded PTS regressions near the start.
+struct mp_dts_pts_repair {
+    bool active, rejected;
+    unsigned packets, regressions;
+    uint64_t frames;
+    double step, last_packet, first, last_raw;
+};
+
+static inline void mp_dts_pts_reset(struct mp_dts_pts_repair *s)
+{
+    // A seek restarts counting at the first decoded frame, not the seek target.
+    // Keep the diagnosis so preroll is decoded without dropping any frames.
+    bool active = s->active;
+    *s = (struct mp_dts_pts_repair){.active = active};
+}
+
+static inline void mp_dts_pts_packet(struct mp_dts_pts_repair *s,
+                                    double pts, double dts, double duration,
+                                    double fps, bool valid)
+{
+    if (s->rejected)
+        return;
+    double step = fps > 0 ? 1.0 / fps : 0;
+    double tolerance = step * 0.001 + 0.000002;
+    if (!valid || !isfinite(pts) || !isfinite(dts) ||
+        !isfinite(step) || step <= 0 || !isfinite(duration) ||
+        fabs(pts - dts) > tolerance ||
+        fabs(duration - step) > tolerance ||
+        (s->packets && (fabs(step - s->step) > tolerance ||
+                       fabs(dts - s->last_packet - step) > tolerance)))
+    {
+        s->rejected = true;
+        s->active = false;
+        return;
+    }
+    s->step = step;
+    s->last_packet = dts;
+    if (s->packets < 1000000)
+        s->packets++;
+}
+
+static inline bool mp_dts_pts_no_drop(const struct mp_dts_pts_repair *s)
+{
+    return !s->rejected && (s->active || (s->packets && s->frames < 64));
+}
+
+static inline double mp_dts_pts_frame(struct mp_dts_pts_repair *s,
+                                     double pts, bool valid)
+{
+    if (s->rejected)
+        return pts;
+    if (!valid || !isfinite(pts)) {
+        s->rejected = true;
+        s->active = false;
+        return pts;
+    }
+    if (!s->frames)
+        s->first = pts;
+    if (s->frames && pts < s->last_raw - s->step * 0.5)
+        s->regressions++;
+    s->last_raw = pts;
+    if (!s->active && s->frames < 64 && s->packets >= 8 &&
+        s->regressions >= 2)
+        s->active = true;
+    // Keep the original epoch rather than permanently preserving the bad
+    // startup timestamps. Activation may correct backwards once; subsequent
+    // frames have an exact cadence with no accumulated floating-point drift.
+    double result = s->active && s->step > 0
+                  ? s->first + s->frames * s->step : pts;
+    s->frames++;
+    return result;
+}
