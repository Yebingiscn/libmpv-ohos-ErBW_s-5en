diff --git a/video/out/ohos_common.c b/video/out/ohos_common.c
--- a/video/out/ohos_common.c
+++ b/video/out/ohos_common.c
@@ -196,6 +196,10 @@ bool vo_ohos_prepare_output(struct vo *vo, int pixel_format)
     struct vo_ohos_state *ctx = vo->ohos;
     if (!vo->opts->ohos_super_resolution)
         return true;
+    if (vo->opts->ohos_sdr_to_hdr) {
+        MP_VERBOSE(vo, "[SuperResolution] Bypassed: SDR-to-HDR takes priority\n");
+        return true;
+    }
     int w, h;
     if (!vo_ohos_surface_size(vo, &w, &h))
         return false;
@@ -367,10 +371,6 @@ void ohos_vpe_check(struct ohos_vpe *vpe, struct vo *vo)
     // from the VO thread, never from a vendor processing callback.
     int error = ohos_vpe_take_error(vpe);
     if (error) {
-        if (vo->opts->ohos_sdr_to_hdr) {
-            MP_ERR(vo, "[SuperResolution] HDR+VPE processing failed (%d); keeping both requested options for diagnosis\n", error);
-            return;
-        }
         MP_WARN(vo, "[SuperResolution] Processing failed (%d); restoring normal output\n", error);
         const char *cmd[] = {"set", "ohos-super-resolution", "no", NULL};
         mp_input_run_cmd(vo->input_ctx, cmd);
