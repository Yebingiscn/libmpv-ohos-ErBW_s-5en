+
+static int control(struct ao *ao, enum aocontrol cmd, void *arg)
+{
+    struct priv *p = ao->priv;
+    if (cmd == AOCONTROL_GET_NATIVE_SPEED) {
+        ((struct ao_native_speed *)arg)->speed = p->speed;
+        return CONTROL_OK;
+    }
+    if (cmd != AOCONTROL_SET_NATIVE_SPEED) return CONTROL_UNKNOWN;
+    struct ao_native_speed *request = arg;
+    double requested = request->speed;
+    request->speed = p->speed;
+    if (!isfinite(requested) || requested < 0.25 || requested > 4) {
+        MP_WARN(ao, "Audio Vivid speed out of range [0.25, 4]: %.3f\n", requested);
+        return CONTROL_ERROR;
+    }
+    if (fabs(requested - p->speed) < 0.00001) return CONTROL_OK;
+    if (!p->renderer) {
+        MP_WARN(ao, "Audio Vivid renderer not ready; retaining %.3fx\n", p->speed);
+        return CONTROL_ERROR;
+    }
+    if (!apply_native_speed(ao, requested)) return CONTROL_ERROR;
+    p->speed = request->speed = requested;
+    p->mapped_time = p->query_time = 0;
+    MP_INFO(ao, "Audio Vivid native speed accepted: %.3f (metadata retained)\n", requested);
+    return CONTROL_OK;
+}
