+    return OH_AudioRenderer_SetSpeed(renderer, speed);
+}
+
+static int sdk_get_speed(void *renderer, float *speed)
+{
+    return OH_AudioRenderer_GetSpeed(renderer, speed);
+}
+
+static bool apply_native_speed(struct ao *ao, double speed)
+{
+    struct priv *p = ao->priv;
+    struct vivid_speed_result result;
+    int accepted = vivid_speed_try(p->renderer, speed, p->speed,
+                                  sdk_set_speed, sdk_get_speed, &result);
+    if (accepted == 1) return true;
+    MP_WARN(ao, "Audio Vivid speed %.3f rejected: set=%d get=%d actual=%.3f; retaining %.3f\n",
+            speed, result.set_status, result.get_status, result.observed, p->speed);
+    if (accepted < 0) {
+        MP_ERR(ao, "Audio Vivid renderer could not restore the previous speed.\n");
+        ao_report_error(ao);
+    }
+    return false;
