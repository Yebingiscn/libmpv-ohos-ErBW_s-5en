diff --git a/audio/out/ohaudio_vivid_speed.h b/audio/out/ohaudio_vivid_speed.h
new file mode 100644
--- /dev/null
+++ b/audio/out/ohaudio_vivid_speed.h
@@ -0,0 +1,27 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+#include <math.h>
+
+struct vivid_speed_result {
+    int set_status, get_status;
+    float observed;
+};
+
+// 1: accepted; 0: rejected and previous speed confirmed; -1: restore failed.
+static inline int vivid_speed_try(void *renderer, float requested, float previous,
+    int (*set)(void *, float), int (*get)(void *, float *), struct vivid_speed_result *result)
+{
+    result->observed = 0;
+    result->set_status = set(renderer, requested);
+    result->get_status = get(renderer, &result->observed);
+    if (!result->set_status && !result->get_status &&
+        isfinite(result->observed) && fabs(result->observed - requested) < 0.001)
+        return 1;
+    if (!result->get_status && isfinite(result->observed) && fabs(result->observed - previous) < 0.001)
+        return 0;
+    float restored = 0;
+    if (set(renderer, previous) || get(renderer, &restored) || !isfinite(restored) ||
+        fabs(restored - previous) >= 0.001)
+        return -1;
+    return 0;
+}
