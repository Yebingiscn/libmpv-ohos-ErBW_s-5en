         int64_t timestamp = 0;
         OH_AudioStream_Result res = OH_AudioRenderer_GetAudioTimestampInfo(
@@ -191,6 +194,7 @@ static MP_THREAD_VOID clock_thread(void *arg)
         struct timespec mono;
         bool mono_valid = clock_gettime(CLOCK_MONOTONIC, &mono) == 0;
         int64_t now = mp_time_ns();
+        int64_t perf_query_end = perf ? mp_time_ns() : 0;
         int64_t mapped_timestamp = 0;
         bool valid = res == AUDIOSTREAM_SUCCESS && position >= 0 && mono_valid &&
                      ohaudio_clock_translate(timestamp,
@@ -205,6 +209,16 @@ static MP_THREAD_VOID clock_thread(void *arg)
             });
         }
 
+        if (perf && now - perf_last_ns >= MP_TIME_MS_TO_NS(250)) {
