+                   underflows, underflow_ret);
+            perf_last_ns = now;
+        }
         // Diagnostics run off the real-time callback and only on state changes.
         bool current_epoch = atomic_load_explicit(&p->clock_running, memory_order_acquire) &&
             atomic_load_explicit(&p->clock_epoch, memory_order_acquire) == epoch;
