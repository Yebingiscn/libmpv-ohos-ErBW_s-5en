+void update_video_decode_speed(struct MPContext *mpctx, bool force)
+{
+    struct vo_chain *vo_c = mpctx->vo_chain;
+    if (!vo_c || !vo_c->track || !vo_c->track->dec)
+        return;
+    double speed = mpctx->opts->playback_speed;
+    if (use_output_timeline(mpctx) && !mpctx->display_sync_active)
+        speed = audio_timeline_decode_speed(&mpctx->ao_chain->output_timeline,
+                                           ao_get_delay(mpctx->ao), speed);
+    if (force || fabs(vo_c->decoder_speed - speed) > 1e-6) {
+        mp_decoder_wrapper_control(vo_c->track->dec,
+                                   VDCTRL_SET_PLAYBACK_SPEED, &speed);
+        vo_c->decoder_speed = speed;
+        MP_DBG(mpctx, "[Perf] decode-demand requested=%.3f effective=%.3f\n",
+               mpctx->opts->playback_speed, speed);
+    }
+}
+
+double audio_timeline_video_offset(struct MPContext *mpctx, double seconds)
+{
+    double offset;
+    if (use_output_timeline(mpctx) &&
+        audio_timeline_offset(&mpctx->ao_chain->output_timeline,
+                              ao_get_delay(mpctx->ao), seconds, &offset))
+        return offset;
+    return seconds * mpctx->video_speed;
+}
+
+double audio_timeline_video_duration(struct MPContext *mpctx, double pts, double duration)
+{
+    if (duration >= 0 && pts != MP_NOPTS_VALUE && use_output_timeline(mpctx) &&
+        mpctx->audio_status == STATUS_PLAYING && !mpctx->display_sync_active) {
+        const struct audio_output_timeline *t = &mpctx->ao_chain->output_timeline;
+        double delay = ao_get_delay(mpctx->ao), start, end;
+        pts -= mpctx->opts->audio_delay;
+        if (audio_timeline_wait(t, delay, pts, &start) &&
+            audio_timeline_wait(t, delay, pts + duration, &end) && end >= start)
+            return end - start;
+    }
+    return duration / mpctx->video_speed;
+}
