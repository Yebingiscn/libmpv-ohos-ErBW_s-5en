+
+// Keep decode capacity for all PCM still awaiting playback, even after the
+// requested speed falls. Faster requests take effect immediately.
+static inline double audio_timeline_decode_speed(const struct audio_output_timeline *t,
+                                                 double delay, double requested)
+{
+    double pts;
+    if (!audio_timeline_pts(t, delay, &pts))
+        return requested;
+    double played = t->written - delay;
+    for (unsigned i = 0; i < t->count; ++i) {
+        const struct audio_timeline_segment *s =
+            &t->segments[(t->first + i) % AUDIO_TIMELINE_CAPACITY];
+        if (s->end > played + 1e-9)
+            requested = fmax(requested, s->speed);
+    }
+    return requested;
+}
+
+// Convert real output seconds to a media-time offset across speed boundaries.
+static inline bool audio_timeline_offset(const struct audio_output_timeline *t,
+                                         double delay, double seconds, double *offset)
+{
+    double current, future;
+    if (!isfinite(seconds) || seconds < 0 ||
+        !audio_timeline_pts(t, delay, &current) ||
+        !audio_timeline_pts(t, fmax(0, delay - seconds), &future))
+        return false;
+    if (seconds > delay) {
+        const struct audio_timeline_segment *last =
+            &t->segments[(t->first + t->count - 1) % AUDIO_TIMELINE_CAPACITY];
+        future += (seconds - delay) * last->speed;
+    }
+    // Reject timestamp gaps in the projected interval, just like frame waits.
+    double wait;
+    if (!audio_timeline_wait(t, delay, future, &wait) || fabs(wait - seconds) > 1e-7)
+        return false;
+    *offset = future - current;
+    return true;
+}
