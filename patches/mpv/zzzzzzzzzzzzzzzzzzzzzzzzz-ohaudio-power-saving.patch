         res = OH_AudioStreamBuilder_SetSampleFormat(
             p->builder, stream_sample_format(renderer_format));
@@ -932,6 +935,13 @@ static int init(struct ao* ao)
 
     res = OH_AudioStreamBuilder_GenerateRenderer(p->builder, &p->renderer);
 
