diff --git a/audio/out/ao_ohaudio.c b/audio/out/ao_ohaudio.c
new file mode 100644
index 0000000000000000000000000000000000000000..5010eef71598c2ab99b18ad7b2441e17a2e8510c
--- /dev/null
+++ b/audio/out/ao_ohaudio.c
@@ -0,0 +1,277 @@
+/*
+ * OHAudio audio output driver.
+ *
+ * Copyright (C) 2025 Bao Han <erbws@foxmail.com>
+ *
+ * This file is part of mpv.
+ *
+ * mpv is free software; you can redistribute it and/or
