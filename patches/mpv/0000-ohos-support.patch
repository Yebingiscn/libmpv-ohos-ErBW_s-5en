diff --git a/video/out/opengl/context_ohos.c b/video/out/opengl/context_ohos.c
new file mode 100644
index 0000000000000000000000000000000000000000..5d71cfb275795d79566e5ff1d70a4bd8dd20ba41
--- /dev/null
+++ b/video/out/opengl/context_ohos.c
@@ -0,0 +1,140 @@
+/*
