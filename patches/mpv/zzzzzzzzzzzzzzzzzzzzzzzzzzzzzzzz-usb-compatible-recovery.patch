diff --git a/audio/out/usb_audio_pcm.h b/audio/out/usb_audio_pcm.h
new file mode 100644
index 0000000..02c4f4d
--- /dev/null
+++ b/audio/out/usb_audio_pcm.h
@@ -0,0 +1,19 @@
+/* USB PCM packing policy. SPDX-License-Identifier: LGPL-2.1-or-later */
+#ifndef MP_USB_AUDIO_PCM_H
+#define MP_USB_AUDIO_PCM_H
+#include <stdbool.h>
+#include <stdint.h>
+// word is a signed PCM sample left-aligned in a 32-bit unsigned container.
+static inline bool ua_pcm_pack(uint32_t word, unsigned bytes, unsigned bits,
+                               bool compatible, uint8_t *dst)
+{
+    if (bytes < 2 || bytes > 4 || bits < 16 || bits > bytes * 8) return false;
+    unsigned precision_shift = 32 - bits;
+    uint32_t mask = precision_shift ? (1u << precision_shift) - 1 : 0;
+    if (!compatible && (word & mask)) return false;
+    word &= ~mask;
+    word >>= 32 - bytes * 8;
+    for (unsigned i = 0; i < bytes; i++) dst[i] = (uint8_t)(word >> (i * 8));
+    return true;
+}
+#endif
