-// Run before OHCodec begins presenting frames. The font provider can scan
-// system fonts on first use; do not defer this work until playback is running.
+// Each worker owns a private OSD/config snapshot while scanning fonts.
+// Never hold the playback OSD lock during the expensive provider setup.
+static MP_THREAD_VOID preload_font_thread(void *arg)
+{
+    struct osd_state *osd = arg;
+    int64_t begin = mp_time_ns();
+    struct osd_state *prepared = osd_create(osd->global);
+    m_config_cache_update(prepared->opts_cache);
+    create_ass_renderer(prepared, &prepared->objs[OSDTYPE_OSD]->ass);
+    create_ass_renderer(prepared, &prepared->external_preload);
+
+    mp_mutex_lock(&osd->lock);
+    struct osd_object *builtin = osd->objs[OSDTYPE_OSD];
+    if (!builtin->ass.render) {
+        builtin->ass = prepared->objs[OSDTYPE_OSD]->ass;
+        prepared->objs[OSDTYPE_OSD]->ass = (struct ass_state){0};
+    }
+    struct osd_object *external = osd->objs[OSDTYPE_EXTERNAL];
+    if (!osd->external_preload.render) {
+        osd->external_preload = prepared->external_preload;
+        prepared->external_preload = (struct ass_state){0};
+    }
+    // An overlay command may have arrived while preparation was pending.
+    for (int i = 0; i < external->num_externals; i++) {
+        struct osd_external *entry = external->externals[i];
+        if (!entry->ass.render && osd->external_preload.render) {
+            entry->ass = osd->external_preload;
+            osd->external_preload = (struct ass_state){0};
+            MP_DBG(osd, "[Perf] osd-font-reuse pending id=%lld\n",
+                   (long long)entry->ov.id);
+        }
+    }
+    osd->fonts_pending = false;
+    builtin->osd_changed = true;
+    external->changed = true;
+    builtin->vo_change_id++;
+    external->vo_change_id++;
+    osd->want_redraw_notification = true;
+    MP_DBG(osd, "[Perf] osd-font-preload async-ready costMs=%.3f\n",
+           (mp_time_ns() - begin) / 1e6);
+    mp_mutex_unlock(&osd->lock);
+    osd_free(prepared);
+    MP_THREAD_RETURN();
+}
