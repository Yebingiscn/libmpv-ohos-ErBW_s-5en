+// Integer upload fallbacks (e.g. GLES without R16 UNORM) cannot use
+// hardware bilinear sampling. NULL filters let libplacebo choose sampling
+// supported by the source texture instead of disabling the scaler on error.
+static void adapt_sampling(const struct pl_frame *frame,
+                           struct pl_render_params *params)
+{
+    for (int n = 0; n < frame->num_planes; n++) {
+        pl_tex tex = frame->planes[n].texture;
+        if (tex && !(tex->params.format->caps & PL_FMT_CAP_LINEAR)) {
+            params->upscaler = NULL;
+            params->downscaler = NULL;
+            params->plane_upscaler = NULL;
+            params->plane_downscaler = NULL;
+            return;
+        }
+    }
+}
