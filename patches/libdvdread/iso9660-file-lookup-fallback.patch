+                                 uint32_t *len)
+{
+  uint32_t start = UDFFindFile(ctx, filename, len);
+
+  if (!start) {
+    start = ISO9660FindFile(ctx, filename, len);
+    if (start)
+      Log1(ctx, "Using ISO9660 fallback for %s", filename);
+  }
+
+  return start;
