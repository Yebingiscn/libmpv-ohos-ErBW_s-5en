diff --git a/src/maleoon_policy.h b/src/maleoon_policy.h
new file mode 100644
index 0000000..2737e29
--- /dev/null
+++ b/src/maleoon_policy.h
@@ -0,0 +1,37 @@
+/* Private OHOS policy. No public ABI or application setting. */
+#pragma once
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+
+static inline bool pl_maleoon_name(const char *name)
+{
+    if (!name) return false;
+    const char match[] = "maleoon";
+    for (; *name; name++) {
+        size_t i = 0;
+        for (; match[i] && name[i]; i++) {
+            char c = name[i];
+            if (c >= 'A' && c <= 'Z') c += 'a' - 'A';
+            if (c != match[i]) break;
+        }
+        if (!match[i]) return true;
+    }
+    return false;
+}
+
+// Only opted-in ArtCNN passes whose output block has an integral 1x/2x/4x
+// relation to invocation count. Preserve that relation and all barriers.
+static inline bool pl_maleoon_workgroup(bool maleoon, bool opted_in,
+    uint32_t max_threads, uint32_t max_x, uint32_t max_y,
+    int *bw, int *bh, int *tw, int *th)
+{
+    if (!maleoon || !opted_in || max_threads < 64 || max_x < 8 || max_y < 8 ||
+        *tw != 12 || *th != 16 ||
+        (*bw != 12 && *bw != 24 && *bw != 48) || (*bh != 16 && *bh != 32)) return false;
+    *bw = (*bw / *tw) * 8;
+    *bh = (*bh / *th) * 8;
+    *tw = *th = 8;
+    return true;
+}
