diff --git a/src/opengl/upload_pool.h b/src/opengl/upload_pool.h
new file mode 100644
--- /dev/null
+++ b/src/opengl/upload_pool.h
@@ -0,0 +1,115 @@
+/* Bounded GLES 3 software-frame staging. The owning GL context must be current.
+ * SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <string.h>
+
+#define GLES_UPLOAD_SLOTS 6
+#define GLES_UPLOAD_MIN (32u * 1024u)
+#define GLES_UPLOAD_MAX (16u * 1024u * 1024u)
+#define GLES_UPLOAD_BUDGET (64u * 1024u * 1024u)
+
+struct gles_upload_slot {
+    GLuint buffer;
+    GLsync fence;
+    size_t capacity;
+};
+
+struct gles_upload_pool {
+    struct gles_upload_slot slots[GLES_UPLOAD_SLOTS];
+    size_t allocated;
+    bool disabled;
+    bool announced;
+};
+
+// Never wait for the GPU. Busy slots and oversized planes use the original
+// client-memory upload. Only sequential CPU writes target this mapped memory;
+// the VP9 decoder's reference-frame reads remain in ordinary cached RAM.
+static inline int gles_upload_prepare(struct gles_upload_pool *pool,
+                               const gl_funcs *gl, const void *pixels, size_t size)
+{
+    if (pool->disabled || !pixels || size < GLES_UPLOAD_MIN || size > GLES_UPLOAD_MAX)
+        return -1;
+
+    int best = -1, grow = -1;
+    for (int i = 0; i < GLES_UPLOAD_SLOTS; i++) {
+        struct gles_upload_slot *slot = &pool->slots[i];
+        if (slot->fence) {
+            GLenum status = gl->ClientWaitSync(slot->fence, 0, 0);
+            if (status == GL_TIMEOUT_EXPIRED)
+                continue;
+            if (status != GL_ALREADY_SIGNALED && status != GL_CONDITION_SATISFIED) {
+                pool->disabled = true;
+                return -1;
+            }
+            gl->DeleteSync(slot->fence);
+            slot->fence = NULL;
+        }
+        if (slot->buffer && slot->capacity >= size) {
+            if (best < 0 || slot->capacity < pool->slots[best].capacity)
+                best = i;
+        } else if (pool->allocated - slot->capacity + size <= GLES_UPLOAD_BUDGET) {
+            if (grow < 0 || slot->capacity > pool->slots[grow].capacity)
+                grow = i;
+        }
+    }
+
+    int index = best >= 0 ? best : grow;
+    if (index < 0)
+        return -1;
+    struct gles_upload_slot *slot = &pool->slots[index];
+    if (!slot->buffer) {
+        gl->GenBuffers(1, &slot->buffer);
+        if (!slot->buffer) {
+            pool->disabled = true;
+            return -1;
+        }
+    }
+    gl->BindBuffer(GL_PIXEL_UNPACK_BUFFER, slot->buffer);
+    if (slot->capacity < size) {
+        gl->BufferData(GL_PIXEL_UNPACK_BUFFER, size, NULL, GL_STREAM_DRAW);
+        pool->allocated += size - slot->capacity;
+        slot->capacity = size;
+    }
+    void *mapped = gl->MapBufferRange(GL_PIXEL_UNPACK_BUFFER, 0, size,
+                                     GL_MAP_WRITE_BIT | GL_MAP_UNSYNCHRONIZED_BIT);
+    if (!mapped) {
+        gl->BindBuffer(GL_PIXEL_UNPACK_BUFFER, 0);
+        pool->disabled = true;
+        return -1;
+    }
+    memcpy(mapped, pixels, size);
+    if (!gl->UnmapBuffer(GL_PIXEL_UNPACK_BUFFER)) {
+        gl->BindBuffer(GL_PIXEL_UNPACK_BUFFER, 0);
+        pool->disabled = true;
+        return -1;
+    }
+    // Leave the PBO bound for TexSubImage2D; the caller unbinds it afterwards.
+    return index;
+}
+
+static inline bool gles_upload_submit(struct gles_upload_pool *pool,
+                               const gl_funcs *gl, int index)
+{
+    pool->slots[index].fence = gl->FenceSync(GL_SYNC_GPU_COMMANDS_COMPLETE, 0);
+    if (!pool->slots[index].fence) {
+        // Do not reuse untracked in-flight storage, even on a later frame.
+        pool->disabled = true;
+        return false;
+    }
+    return true;
+}
+
+static inline void gles_upload_destroy(struct gles_upload_pool *pool, const gl_funcs *gl)
+{
+    for (int i = 0; i < GLES_UPLOAD_SLOTS; i++) {
+        struct gles_upload_slot *slot = &pool->slots[i];
+        if (slot->fence)
+            gl->DeleteSync(slot->fence);
+        if (slot->buffer)
+            gl->DeleteBuffers(1, &slot->buffer);
+    }
+    *pool = (struct gles_upload_pool) {0};
+}
